---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

// Valeur de repli si la page n'a pas fourni sa propre description — c'est
// UNIQUEMENT dans ce cas que le script ci-dessous la remplace par
// site_settings.seo_description : une page qui a rédigé la sienne
// (ex. /contact) n'est jamais écrasée par le réglage global du site.
const DEFAULT_DESCRIPTION = "L'ANB rassemble, accompagne et valorise les Nigériens et les amis du Niger à Bordeaux.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="description" id="meta-description" data-is-default={description === DEFAULT_DESCRIPTION ? 'true' : 'false'} content={description} />
    <title>{title} — ANB Bordeaux</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div style="width:100%; min-height:100vh; background:#F8F4EC; color:#1F2925; overflow-x:hidden; position:relative;">
      <Header />
      <slot />
      <Footer />
      <Chatbot />
    </div>
    <script define:vars={{ pageTitle: title, isHome: Astro.url.pathname === '/' }}>
      // Reflète identite_nom / seo_titre / seo_description édités depuis le
      // Super Admin (src/pages/api/settings.js -> site_settings), sur le
      // même principe déjà en place pour le Footer (best-effort, jamais
      // bloquant).
      // - identite_nom remplace le suffixe fixe "ANB Bordeaux" sur TOUTES
      //   les pages (ex. "Contact — Association des Nigériens à Bordeaux").
      // - seo_titre est une valeur unique et globale (pas un suffixe par
      //   page) : elle ne remplace le <title> en entier que sur l'accueil,
      //   seule page où un "titre du site" complet a un sens sans dupliquer
      //   ni écraser les titres distincts déjà écrits pour chaque page.
      // - seo_description ne remplace la meta description QUE si la page
      //   utilise la valeur de repli du Layout — une description
      //   spécifique déjà rédigée par une page (ex. /contact) n'est jamais
      //   écrasée par le réglage global.
      fetch('/api/settings')
        .then((res) => res.json())
        .then(({ settings }) => {
          if (isHome && settings.seo_titre) {
            document.title = settings.seo_titre;
          } else if (settings.identite_nom) {
            document.title = `${pageTitle} — ${settings.identite_nom}`;
          }
          const metaDescription = document.getElementById('meta-description');
          if (metaDescription && metaDescription.dataset.isDefault === 'true' && settings.seo_description) {
            metaDescription.setAttribute('content', settings.seo_description);
          }
        })
        .catch(() => {});
    </script>
    <script>
      // Drives the orange "shelf-thread" progress bar under each mobile
      // horizontal scroll shelf. A thread is any `.shelf-thread` element
      // immediately following a `.mobile-shelf` in the markup.
      function initShelfThreads() {
        document.querySelectorAll<HTMLElement>('.mobile-shelf').forEach((shelf) => {
          const thread = shelf.nextElementSibling as HTMLElement | null;
          if (!thread?.classList.contains('shelf-thread')) return;
          const thumb = thread.querySelector<HTMLElement>('span');
          if (!thumb) return;

          const update = () => {
            const trackWidth = thread.clientWidth;
            const visibleRatio = Math.min(1, shelf.clientWidth / shelf.scrollWidth);
            const thumbWidth = visibleRatio * trackWidth;
            const maxScroll = shelf.scrollWidth - shelf.clientWidth;
            const scrollRatio = maxScroll > 0 ? shelf.scrollLeft / maxScroll : 0;
            thumb.style.width = `${thumbWidth}px`;
            thumb.style.transform = `translateX(${scrollRatio * (trackWidth - thumbWidth)}px)`;
          };

          shelf.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        });
      }
      document.addEventListener('DOMContentLoaded', initShelfThreads);

      // Reveal-on-scroll: fades in [data-reveal] elements (and staggers the
      // children of [data-reveal-group] containers) the first time they
      // enter the viewport. Pure CSS transition + a single IntersectionObserver
      // — no animation library.
      function initReveal() {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-group]');
        if (!targets.length) return;

        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        targets.forEach((el) => observer.observe(el));
      }
      document.addEventListener('DOMContentLoaded', initReveal);
    </script>
  </body>
</html>
