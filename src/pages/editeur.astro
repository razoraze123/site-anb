---
export const prerender = false;

const user = await Astro.session?.get('user');
if (!user || !['admin', 'super_admin', 'editeur'].includes(user.role)) {
  return Astro.redirect('/connexion');
}

const ROLE_LABELS = { admin: 'Admin', super_admin: 'Super Admin', editeur: 'Éditeur' };
const roleLabel = ROLE_LABELS[user.role] || user.role;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Espace ANB — Éditeur</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --color-cream: #F8F4EC;
      --color-green: #176B4D;
      --color-orange: #E97824;
      --color-dark: #1F2925;
      --color-sand: #E8D8BF;
      --color-body-text: #3f4a45;
      --color-muted-text: #5a655f;
      --font-display: 'Unbounded', sans-serif;
      --font-body: 'Manrope', sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-body);
      background: var(--color-cream);
      color: var(--color-dark);
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; }
    button, input, textarea, select { font-family: inherit; }
    ::selection { background: var(--color-orange); color: #FFFFFF; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: rgba(31,41,37,0.15); border-radius: 8px; }
    
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in { animation: fadeInUp 0.4s ease both; }
    .hidden { display: none !important; }
    .active-nav-btn {
      color: var(--color-green) !important;
      background: rgba(23, 107, 77, 0.09) !important;
      font-weight: 700 !important;
    }
    
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--color-body-text);
      cursor: pointer;
      transition: all 0.15s ease;
      background: transparent;
      border: none;
      width: 100%;
      text-align: left;
    }
    .sidebar-link:hover {
      background: rgba(31, 41, 37, 0.04);
      color: var(--color-dark);
    }
    
    .nav-desktop-only { display: flex; }
    .nav-mobile-only { display: none; }
    @media (max-width: 980px) {
      .nav-desktop-only { display: none; }
      .nav-mobile-only { display: flex; }
    }
  </style>
</head>
<body>

  <!-- APP SHELL -->
  <div id="app-shell-view" style="display:flex; min-height:100vh;">
    
    <!-- SIDEBAR DESKTOP -->
    <aside class="nav-desktop-only" style="width:260px; flex-shrink:0; background:#FFFFFF; border-right:1px solid rgba(31,41,37,0.08); display:flex; flex-direction:column; height:100vh; position:sticky; top:0;">
      <div style="padding:22px 20px; display:flex; align-items:center; gap:12px; border-bottom:1px solid rgba(31,41,37,0.06);">
        <div style="width:38px; height:38px; border-radius:11px; background:#176B4D; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <span style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:12px; color:#FFFFFF;">ANB</span>
        </div>
        <div style="flex:1; min-width:0;">
          <div style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:14.5px; color:#176B4D; white-space:nowrap;">Espace ANB</div>
          <div style="font-size:11px; color:#5a655f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Éditeur / Bénévole</div>
        </div>
      </div>
      
      <nav id="desktop-sidebar-nav" style="flex:1; overflow-y:auto; padding:16px 12px; display:flex; flex-direction:column; gap:4px;">
        <!-- Dynamically rendered -->
      </nav>
      
      <div style="padding:16px; border-top:1px solid rgba(31,41,37,0.06); display:flex; align-items:center; gap:12px;">
        <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824); flex-shrink:0;"></div>
        <div style="flex:1; min-width:0;">
          <div id="sidebar-user-name" style="font-size:13.5px; font-weight:700; color:#1F2925; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{user.nom}</div>
          <div style="font-size:11.5px; color:#5a655f;">{roleLabel}</div>
        </div>
        <button class="logout-btn" aria-label="Déconnexion" style="width:34px; height:34px; border-radius:10px; background:#F8F4EC; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="1.8"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
        </button>
      </div>
    </aside>

    <!-- MOBILE DRAWER -->
    <div id="mobile-sidebar-drawer" class="hidden" style="position:fixed; inset:0; z-index:300; background:#FFFFFF; display:flex; flex-direction:column; overflow-y:auto;">
      <div style="padding:20px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(31,41,37,0.06);">
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:38px; height:38px; border-radius:11px; background:#176B4D; display:flex; align-items:center; justify-content:center;">
            <span style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:12px; color:#FFFFFF;">ANB</span>
          </div>
          <div style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:14.5px; color:#176B4D; white-space:nowrap;">Espace ANB</div>
        </div>
        <button id="close-mobile-drawer" aria-label="Fermer" style="width:40px; height:40px; border-radius:10px; background:#F8F4EC; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="2"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
        </button>
      </div>
      <nav id="mobile-sidebar-nav" style="flex:1; padding:16px; display:flex; flex-direction:column; gap:4px;">
        <!-- Dynamically rendered -->
      </nav>
      <div style="padding:16px; border-top:1px solid rgba(31,41,37,0.06);">
        <button class="logout-btn" style="width:100%; background:#F8F4EC; border:none; padding:14px; border-radius:12px; font-weight:700; font-size:14px; cursor:pointer; color:#1F2925;">Se déconnecter</button>
      </div>
    </div>

    <!-- MAIN COLUMN -->
    <div style="flex:1; min-width:0; display:flex; flex-direction:column;">
      
      <!-- TOP BAR -->
      <div style="position:sticky; top:0; z-index:50; background:rgba(248,244,236,0.92); backdrop-filter:blur(8px); border-bottom:1px solid rgba(31,41,37,0.08); padding:16px clamp(16px,3vw,32px); display:flex; align-items:center; gap:16px;">
        <button id="open-mobile-drawer" class="nav-mobile-only" aria-label="Menu" style="width:40px; height:40px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.1); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div style="flex:1; min-width:0;">
          <div style="font-size:12px; color:#5a655f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Espace ANB / <span id="breadcrumb-page-label">Tableau de bord</span></div>
          <div id="title-page-label" style="font-size:17px; font-weight:800; color:#1F2925; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Tableau de bord</div>
        </div>
        <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824); flex-shrink:0;"></div>
      </div>

      <!-- VIEWS CONTAINER -->
      <div style="flex:1; padding:clamp(18px,3vw,32px);">
        
        <!-- EDASH VIEW -->
        <section id="view-edash" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:24px;">
            <div>
              <h1 style="font-size:24px; font-weight:800; color:#1F2925; margin:0 0 6px;">Bonjour {user.nom.split(' ')[0]} 👋</h1>
              <p style="font-size:14.5px; color:#5a655f; margin:0;">Vos contributions attendent d'être publiées.</p>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px;">
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="edash-count-brouillons" style="font-size:22px; font-weight:800; color:#5a655f;">—</div><div style="font-size:13px; color:#5a655f;">Brouillons</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="edash-count-attente" style="font-size:22px; font-weight:800; color:#E97824;">—</div><div style="font-size:13px; color:#5a655f;">En attente de validation</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="edash-count-renvoye" style="font-size:22px; font-weight:800; color:#B14524;">—</div><div style="font-size:13px; color:#5a655f;">Renvoyé avec commentaire</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="edash-count-publies" style="font-size:22px; font-weight:800; color:#176B4D;">—</div><div style="font-size:13px; color:#5a655f;">Publiés</div></div>
            </div>
            <div style="background:rgba(23,107,77,0.06); border-radius:16px; padding:18px; font-size:13.5px; color:#1F2925;">En tant qu'Éditeur, vous pouvez créer des brouillons d'articles, d'événements et de ressources. Ils seront publiés après validation par un Admin ou un Super Admin. Vous n'avez pas accès aux adhésions, messages privés ni aux statistiques détaillées.</div>
            <button class="nav-trigger-btn" data-page="econtenus" style="align-self:flex-start; background:#E97824; color:#FFFFFF; border:none; padding:13px 24px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Nouveau brouillon</button>
          </div>
        </section>

        <!-- ECONTENUS VIEW -->
        <section id="view-econtenus" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px;">
            <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
              <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Mes contenus</h1>
              <button id="toggle-draft-form-btn" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Nouveau brouillon</button>
            </div>

            <div id="draft-form-box" class="hidden" style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:14px;">
              <h3 style="font-size:16px; font-weight:700; color:#1F2925; margin:0;">Nouveau brouillon d'article</h3>
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#1F2925; display:block; margin-bottom:4px;">Titre</label>
                <input id="draft-form-title" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Titre de l'article" />
              </div>
              <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <div style="flex:1; min-width:180px;">
                  <label style="font-size:12.5px; font-weight:700; color:#1F2925; display:block; margin-bottom:4px;">Catégorie</label>
                  <select id="draft-form-category" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;">
                    <option>Communauté</option>
                    <option>Vie associative</option>
                    <option>Bénévolat</option>
                    <option>Culture</option>
                    <option>Solidarité</option>
                    <option>Portraits</option>
                  </select>
                </div>
                <div style="flex:1; min-width:180px;">
                  <label style="font-size:12.5px; font-weight:700; color:#1F2925; display:block; margin-bottom:4px;">Adresse (générée)</label>
                  <input id="draft-form-slug" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px; color:#9aa39c;" placeholder="/actualites/titre-de-larticle" readonly />
                </div>
              </div>
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#1F2925; display:block; margin-bottom:4px;">Résumé</label>
                <textarea id="draft-form-excerpt" rows="2" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px; resize:vertical;" placeholder="Résumé court affiché dans les listes"></textarea>
              </div>
              <div>
                <label style="font-size:12.5px; font-weight:700; color:#1F2925; display:block; margin-bottom:4px;">Contenu</label>
                <textarea id="draft-form-content" rows="6" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px; resize:vertical;" placeholder="Contenu complet de l'article"></textarea>
              </div>
              <div style="display:flex; gap:10px;">
                <button id="save-draft-btn" style="background:#176B4D; color:#FFFFFF; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Enregistrer le brouillon</button>
                <button id="cancel-draft-btn" style="background:#F8F4EC; color:#1F2925; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Annuler</button>
              </div>
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap;" class="econtenus-filter-container">
              <!-- Onglets de filtre par statut, générés dynamiquement -->
            </div>

            <div style="background:#FFFFFF; border-radius:20px; padding:8px; box-shadow:0 8px 24px rgba(31,41,37,0.05);" id="editor-contents-list">
              <!-- Dynamic -->
            </div>
          </div>
        </section>

        <!-- MON PROFIL VIEW -->
        <section id="view-profil" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px; max-width:600px;">
            <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Mon profil</h1>
            <div style="background:#FFFFFF; border-radius:20px; padding:26px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:16px;">
              <div style="display:flex; align-items:center; gap:16px;">
                <div style="width:56px; height:56px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824);"></div>
                <div>
                  <div id="profile-header-name" style="font-size:16px; font-weight:700; color:#1F2925;">{user.nom}</div>
                  <div style="font-size:13px; color:#5a655f;">{roleLabel}</div>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nom complet</label>
                <input id="profile-form-name" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" value={user.nom} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">E-mail</label>
                <input id="profile-form-email" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="vous@anb-bordeaux.fr" value={user.email} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Rôle</label>
                <input readonly style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px; color:#9aa39c;" value={roleLabel} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Laisser vide pour ne pas changer" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Confirmer le nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password-confirm" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Ressaisir le mot de passe" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password-confirm" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <button id="save-profile-btn" style="align-self:flex-start; background:#176B4D; color:#FFFFFF; border:none; padding:12px 24px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Enregistrer</button>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>

  <script>
    // State management
    const state = {
      user: 'editeur',
      page: 'edash',
      editingDraftId: null,
      econtenusFilter: 'Tous'
    };

    const navigationItems = [
      { key: 'edash', label: 'Tableau de bord' },
      { key: 'econtenus', label: 'Mes contenus' },
      { type: 'separator' },
      { key: 'profil', label: 'Mon profil' }
    ];

    const svgMap = {
      edash: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="8" height="8" rx="2"></rect><rect x="13" y="3" width="8" height="8" rx="2"></rect><rect x="3" y="13" width="8" height="8" rx="2"></rect><rect x="13" y="13" width="8" height="8" rx="2"></rect></svg>`,
      econtenus: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="7" y1="9" x2="17" y2="9"></line><line x1="7" y1="13" x2="17" y2="13"></line></svg>`,
      profil: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.4"></circle><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"></path></svg>`
    };

    // Rempli par loadEcontenus() depuis GET /api/editeur/dashboard. Seuls
    // les articles sont réellement pris en charge (pas d'API pour créer un
    // brouillon d'événement/ressource) — tout s'affiche donc en "Article".
    let editorContents = [];
    const STATUS_TONE = { 'Brouillon': 'n', 'En attente': 'o', 'Renvoyé': 'r', 'Publié': 'g' };

    function getBadgeHtml(label, tone) {
      const map = {
        g: { bg: 'rgba(23,107,77,0.12)', color: '#176B4D' },
        o: { bg: 'rgba(233,120,36,0.16)', color: '#B75E12' },
        r: { bg: 'rgba(177,69,36,0.13)', color: '#B14524' },
        n: { bg: 'rgba(31,41,37,0.08)', color: '#5a655f' }
      };
      const c = map[tone] || map.n;
      return `<span style="background:${c.bg}; color:${c.color}; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:700;">${label}</span>`;
    }

    document.addEventListener('DOMContentLoaded', () => {
      generateNav();
      let initialPage = 'edash';
      try {
        const saved = sessionStorage.getItem('editeur-current-page');
        if (saved && document.getElementById(`view-${saved}`)) initialPage = saved;
      } catch {}
      goPage(initialPage);

      document.querySelectorAll('.logout-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          window.location.href = '/connexion';
        });
      });

      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const mobileDrawer = document.getElementById('mobile-sidebar-drawer');

      openDrawerBtn.addEventListener('click', () => {
        mobileDrawer.classList.remove('hidden');
      });
      closeDrawerBtn.addEventListener('click', () => {
        mobileDrawer.classList.add('hidden');
      });

      // Nouveau brouillon : formulaire + slug auto-généré depuis le titre
      const draftFormBox = document.getElementById('draft-form-box');
      document.getElementById('toggle-draft-form-btn').addEventListener('click', () => {
        if (draftFormBox.classList.contains('hidden')) {
          clearDraftForm();
          draftFormBox.classList.remove('hidden');
        } else {
          draftFormBox.classList.add('hidden');
          clearDraftForm();
        }
      });
      document.getElementById('cancel-draft-btn').addEventListener('click', () => {
        draftFormBox.classList.add('hidden');
        clearDraftForm();
      });
      document.getElementById('draft-form-title').addEventListener('input', (e) => {
        if (state.editingDraftId) return; // ne pas régénérer le slug d'un contenu existant
        document.getElementById('draft-form-slug').value = '/actualites/' + e.target.value
          .toLowerCase()
          .trim()
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '')
          .replace(/[^a-z0-9]+/g, '-');
      });
      document.getElementById('save-draft-btn').addEventListener('click', saveDraft);

      // Afficher/masquer un champ mot de passe (délégation, couvre les
      // boutons injectés plus tard).
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.toggle-password-visibility-btn');
        if (!btn) return;
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.setAttribute('aria-label', showing ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
      });

      document.getElementById('save-profile-btn').addEventListener('click', saveProfile);
    });

    function goPage(pageKey) {
      state.page = pageKey;
      
      document.querySelectorAll('.sidebar-link').forEach(link => {
        if (link.dataset.page === pageKey) {
          link.classList.add('active-nav-btn');
        } else {
          link.classList.remove('active-nav-btn');
        }
      });

      const pageTitleMap = {
        edash: 'Tableau de bord', econtenus: 'Mes contenus', profil: 'Mon profil'
      };

      document.getElementById('breadcrumb-page-label').textContent = pageTitleMap[pageKey] || '';
      document.getElementById('title-page-label').textContent = pageTitleMap[pageKey] || '';

      document.querySelectorAll('section[id^="view-"]').forEach(sec => {
        sec.classList.add('hidden');
      });
      
      const targetView = document.getElementById(`view-${pageKey}`);
      if (targetView) {
        targetView.classList.remove('hidden');
        // Retient l'onglet courant pour qu'un rechargement de page (F5) y
        // revienne au lieu de repartir sur Tableau de bord.
        try { sessionStorage.setItem('editeur-current-page', pageKey); } catch {}
      }

      document.getElementById('mobile-sidebar-drawer').classList.add('hidden');

      renderPageDetails(pageKey);
    }

    function generateNav() {
      const desktopContainer = document.getElementById('desktop-sidebar-nav');
      const mobileContainer = document.getElementById('mobile-sidebar-nav');

      desktopContainer.innerHTML = '';
      mobileContainer.innerHTML = '';

      function createLink(item) {
        const link = document.createElement('a');
        link.className = 'sidebar-link';
        link.dataset.page = item.key;
        link.style.cursor = 'pointer';
        const svgContent = svgMap[item.key] || '';
        link.innerHTML = `${svgContent}<span>${item.label}</span>`;
        link.addEventListener('click', () => {
          goPage(item.key);
        });
        return link;
      }

      navigationItems.forEach(item => {
        if (item.type === 'separator') {
          const sep = document.createElement('div');
          sep.style.cssText = 'height:1px; background:rgba(31,41,37,0.07); margin:10px 6px;';
          desktopContainer.appendChild(sep);
          mobileContainer.appendChild(sep.cloneNode(true));
        } else {
          desktopContainer.appendChild(createLink(item));
          mobileContainer.appendChild(createLink(item));
        }
      });
    }

    function renderPageDetails(pageKey) {
      if (pageKey === 'econtenus') {
        loadEcontenus();
      } else if (pageKey === 'edash') {
        loadEdashCounts();
      } else if (pageKey === 'profil') {
        document.getElementById('profile-form-password').value = '';
        document.getElementById('profile-form-password-confirm').value = '';
      }
    }

    async function loadEdashCounts() {
      try {
        const res = await fetch('/api/editeur/dashboard');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur.');
        document.getElementById('edash-count-brouillons').textContent = data.counts.brouillons;
        document.getElementById('edash-count-attente').textContent = data.counts.en_attente;
        document.getElementById('edash-count-renvoye').textContent = data.counts.renvoye;
        document.getElementById('edash-count-publies').textContent = data.counts.publies;
      } catch {
        // Silencieux : les tirets par défaut restent affichés.
      }
    }

    async function loadEcontenus() {
      const list = document.getElementById('editor-contents-list');
      list.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Chargement…</div>';
      try {
        const res = await fetch('/api/editeur/dashboard');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');
        editorContents = data.items;
        renderEcontenus();
      } catch (err) {
        list.innerHTML = `<div style="padding:24px; font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }

    // Ordre de priorité par défaut : ce qui demande une action d'abord
    // (renvoyé puis brouillon), pour ne pas le perdre au milieu des
    // contenus déjà publiés/en attente quand la liste grandit.
    const STATUS_PRIORITY = { 'Renvoyé': 0, 'Brouillon': 1, 'En attente': 2, 'Publié': 3 };
    const ECONTENUS_FILTERS = ['Tous', 'Renvoyé', 'Brouillon', 'En attente', 'Publié'];

    function renderEcontenusFilters() {
      const wrapper = document.querySelector('.econtenus-filter-container');
      wrapper.innerHTML = '';

      ECONTENUS_FILTERS.forEach((f) => {
        const count = f === 'Tous' ? editorContents.length : editorContents.filter((c) => c.status === f).length;
        if (f !== 'Tous' && count === 0) return; // pas d'onglet vide qui encombre
        const btn = document.createElement('button');
        btn.style.cssText = 'border:2px solid #176B4D; padding:8px 16px; border-radius:999px; font-weight:700; font-size:13px; cursor:pointer;';
        if (state.econtenusFilter === f) {
          btn.style.background = '#176B4D';
          btn.style.color = '#FFFFFF';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = '#176B4D';
        }
        btn.textContent = `${f} (${count})`;
        btn.addEventListener('click', () => {
          state.econtenusFilter = f;
          renderEcontenus();
        });
        wrapper.appendChild(btn);
      });
    }

    function renderEcontenus() {
      renderEcontenusFilters();

      const list = document.getElementById('editor-contents-list');
      list.innerHTML = '';

      if (editorContents.length === 0) {
        list.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Aucun contenu pour l\'instant — créez votre premier brouillon.</div>';
        return;
      }

      const filtered = editorContents
        .filter((c) => state.econtenusFilter === 'Tous' || c.status === state.econtenusFilter)
        .sort((a, b) => (STATUS_PRIORITY[a.status] ?? 9) - (STATUS_PRIORITY[b.status] ?? 9));

      if (filtered.length === 0) {
        list.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Rien dans ce filtre.</div>';
        return;
      }

      filtered.forEach(c => {
        const canSubmit = c.status === 'Brouillon' || c.status === 'Renvoyé';
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; flex-direction:column; gap:8px; padding:16px; border-bottom:1px solid rgba(31,41,37,0.06);';
        row.innerHTML = `
          <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <span style="background:rgba(23,107,77,0.08); color:#176B4D; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;">Article</span>
            <div style="flex:1; min-width:220px; font-size:14px; font-weight:700; color:#1F2925;">${c.title}</div>
            ${getBadgeHtml(c.status, STATUS_TONE[c.status] || 'n')}
            ${canSubmit ? `<button class="edit-draft-btn" data-id="${c.id}" style="background:#F8F4EC; border:none; padding:9px 16px; border-radius:9px; font-size:12.5px; font-weight:700; cursor:pointer; color:#1F2925;">Modifier</button>` : ''}
            ${canSubmit ? `<button class="submit-draft-btn" data-id="${c.id}" style="background:#176B4D; color:#FFFFFF; border:none; padding:9px 16px; border-radius:9px; font-size:12.5px; font-weight:700; cursor:pointer;">Soumettre</button>` : ''}
          </div>
          ${c.commentaire_retour ? `<div style="font-size:13px; color:#B14524; background:rgba(177,69,36,0.08); padding:10px 14px; border-radius:10px;">💬 ${c.commentaire_retour}</div>` : ''}
        `;
        list.appendChild(row);
      });

      document.querySelectorAll('.submit-draft-btn').forEach(btn => {
        btn.addEventListener('click', () => submitDraft(Number(btn.dataset.id)));
      });
      document.querySelectorAll('.edit-draft-btn').forEach(btn => {
        btn.addEventListener('click', () => editDraft(Number(btn.dataset.id)));
      });
    }

    function editDraft(id) {
      const item = editorContents.find((c) => c.id === id);
      if (!item) return;

      state.editingDraftId = id;
      document.getElementById('draft-form-title').value = item.title;
      document.getElementById('draft-form-slug').value = '/actualites/' + item.slug;
      document.getElementById('draft-form-excerpt').value = item.excerpt;
      document.getElementById('draft-form-content').value = item.content;
      const categorySelect = document.getElementById('draft-form-category');
      const optionIndex = [...categorySelect.options].findIndex((o) => o.value === item.category);
      categorySelect.selectedIndex = optionIndex >= 0 ? optionIndex : 0;

      document.querySelector('#draft-form-box h3').textContent = 'Modifier le brouillon';
      document.getElementById('save-draft-btn').textContent = 'Enregistrer les modifications';
      document.getElementById('draft-form-box').classList.remove('hidden');
      document.getElementById('draft-form-box').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function submitDraft(id) {
      if (!confirm('Soumettre ce contenu pour validation ? Vous ne pourrez plus le modifier tant qu\'il est en attente.')) return;
      try {
        const res = await fetch('/api/editeur/submit', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur.');
        await loadEcontenus();
        await loadEdashCounts();
      } catch (err) {
        alert(err.message);
      }
    }

    function clearDraftForm() {
      ['draft-form-title', 'draft-form-slug', 'draft-form-excerpt', 'draft-form-content'].forEach((id) => {
        document.getElementById(id).value = '';
      });
      document.getElementById('draft-form-category').selectedIndex = 0;
      state.editingDraftId = null;
      document.querySelector('#draft-form-box h3').textContent = "Nouveau brouillon d'article";
      document.getElementById('save-draft-btn').textContent = 'Enregistrer le brouillon';
    }

    async function saveDraft() {
      const title = document.getElementById('draft-form-title').value.trim();
      const slug = document.getElementById('draft-form-slug').value.replace('/actualites/', '');
      const excerpt = document.getElementById('draft-form-excerpt').value.trim();
      const content = document.getElementById('draft-form-content').value.trim();
      const category = document.getElementById('draft-form-category').value;

      if (!title || !excerpt || !content) {
        alert('Veuillez remplir le titre, le résumé et le contenu.');
        return;
      }

      const isEdit = state.editingDraftId !== null;
      try {
        const res = await fetch('/api/admin/news', {
          method: isEdit ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(
            isEdit
              ? { id: state.editingDraftId, title, slug, excerpt, content, category }
              : { title, slug, excerpt, content, category }
          )
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur.');
        document.getElementById('draft-form-box').classList.add('hidden');
        clearDraftForm();
        await loadEcontenus();
        await loadEdashCounts();
      } catch (err) {
        alert(err.message);
      }
    }

    async function saveProfile() {
      const nom = document.getElementById('profile-form-name').value.trim();
      const email = document.getElementById('profile-form-email').value.trim();
      const password = document.getElementById('profile-form-password').value;
      const passwordConfirm = document.getElementById('profile-form-password-confirm').value;

      if (password && password !== passwordConfirm) {
        alert('Les deux mots de passe ne correspondent pas.');
        return;
      }

      try {
        const res = await fetch('/api/superadmin/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nom, email, password: password || undefined })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur.');
        alert('Profil enregistré !');
        document.getElementById('profile-form-password').value = '';
        document.getElementById('profile-form-password-confirm').value = '';
        document.getElementById('profile-header-name').textContent = nom;
        document.getElementById('sidebar-user-name').textContent = nom;
      } catch (err) {
        alert(err.message);
      }
    }

    // Bind navigations inside views
    document.querySelectorAll('.nav-trigger-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        goPage(btn.dataset.page);
      });
    });
  </script>

</body>
</html>
