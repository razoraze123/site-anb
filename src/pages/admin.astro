---
import DashboardCore from '../components/admin/DashboardCore.astro';
import ViewActualites from '../components/admin/ViewActualites.astro';
import ViewGalerie from '../components/admin/ViewGalerie.astro';
import ViewEquipe from '../components/admin/ViewEquipe.astro';
import ViewEvenements from '../components/admin/ViewEvenements.astro';
import ViewInscriptions from '../components/admin/ViewInscriptions.astro';
import ViewRecensement from '../components/admin/ViewRecensement.astro';
import ViewMessages from '../components/admin/ViewMessages.astro';
import ViewValidations from '../components/admin/ViewValidations.astro';

export const prerender = false;

const user = await Astro.session?.get('user');
if (!user || !['admin', 'super_admin'].includes(user.role)) {
  return Astro.redirect('/connexion');
}

const ROLE_LABELS = { admin: 'Admin', super_admin: 'Super Admin' };
const roleLabel = ROLE_LABELS[user.role] || user.role;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Espace ANB — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --color-cream: #F8F4EC;
      --color-green: #176B4D;
      --color-orange: #E97824;
      --color-dark: #1F2925;
      --color-sand: #E8D8BF;
      --color-body-text: #3f4a45;
      --color-muted-text: #5a655f;
      --font-display: 'Unbounded', sans-serif;
      --font-body: 'Manrope', sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-body);
      background: var(--color-cream);
      color: var(--color-dark);
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; }
    button, input, textarea, select { font-family: inherit; }
    ::selection { background: var(--color-orange); color: #FFFFFF; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: rgba(31,41,37,0.15); border-radius: 8px; }
    
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in { animation: fadeInUp 0.4s ease both; }
    .hidden { display: none !important; }
    .active-nav-btn {
      color: var(--color-green) !important;
      background: rgba(23, 107, 77, 0.09) !important;
      font-weight: 700 !important;
    }
    
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--color-body-text);
      cursor: pointer;
      transition: all 0.15s ease;
      background: transparent;
      border: none;
      width: 100%;
      text-align: left;
    }
    .sidebar-link:hover {
      background: rgba(31, 41, 37, 0.04);
      color: var(--color-dark);
    }
    
    .nav-desktop-only { display: flex; }
    .nav-mobile-only { display: none; }
    @media (max-width: 980px) {
      .nav-desktop-only { display: none; }
      .nav-mobile-only { display: flex; }
    }
  </style>
</head>
<body>

  <!-- APP SHELL -->
  <div id="app-shell-view" style="display:flex; min-height:100vh;">
    
    <!-- SIDEBAR DESKTOP -->
    <aside class="nav-desktop-only" style="width:260px; flex-shrink:0; background:#FFFFFF; border-right:1px solid rgba(31,41,37,0.08); display:flex; flex-direction:column; height:100vh; position:sticky; top:0;">
      <div style="padding:22px 20px; display:flex; align-items:center; gap:12px; border-bottom:1px solid rgba(31,41,37,0.06);">
        <div style="width:38px; height:38px; border-radius:11px; background:#176B4D; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <span style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:12px; color:#FFFFFF;">ANB</span>
        </div>
        <div style="flex:1; min-width:0;">
          <div style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:14.5px; color:#176B4D; white-space:nowrap;">Espace ANB</div>
          <div style="font-size:11px; color:#5a655f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Admin</div>
        </div>
      </div>
      
      <nav id="desktop-sidebar-nav" style="flex:1; overflow-y:auto; padding:16px 12px; display:flex; flex-direction:column; gap:4px;">
        <!-- Dynamically rendered -->
      </nav>
      
      <div style="padding:16px; border-top:1px solid rgba(31,41,37,0.06); display:flex; align-items:center; gap:12px;">
        <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824); flex-shrink:0;"></div>
        <div style="flex:1; min-width:0;">
          <div id="sidebar-user-name" style="font-size:13.5px; font-weight:700; color:#1F2925; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{user.nom}</div>
          <div style="font-size:11.5px; color:#5a655f;">{roleLabel}</div>
        </div>
        <button class="logout-btn" aria-label="Déconnexion" style="width:34px; height:34px; border-radius:10px; background:#F8F4EC; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="1.8"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
        </button>
      </div>
    </aside>

    <!-- MOBILE DRAWER -->
    <div id="mobile-sidebar-drawer" class="hidden" style="position:fixed; inset:0; z-index:300; background:#FFFFFF; display:flex; flex-direction:column; overflow-y:auto;">
      <div style="padding:20px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(31,41,37,0.06);">
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:38px; height:38px; border-radius:11px; background:#176B4D; display:flex; align-items:center; justify-content:center;">
            <span style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:12px; color:#FFFFFF;">ANB</span>
          </div>
          <div style="font-family:'Unbounded',sans-serif; font-weight:700; font-size:14.5px; color:#176B4D; white-space:nowrap;">Espace ANB</div>
        </div>
        <button id="close-mobile-drawer" aria-label="Fermer" style="width:40px; height:40px; border-radius:10px; background:#F8F4EC; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="2"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
        </button>
      </div>
      <nav id="mobile-sidebar-nav" style="flex:1; padding:16px; display:flex; flex-direction:column; gap:4px;">
        <!-- Dynamically rendered -->
      </nav>
      <div style="padding:16px; border-top:1px solid rgba(31,41,37,0.06);">
        <button class="logout-btn" style="width:100%; background:#F8F4EC; border:none; padding:14px; border-radius:12px; font-weight:700; font-size:14px; cursor:pointer; color:#1F2925;">Se déconnecter</button>
      </div>
    </div>

    <!-- MAIN COLUMN -->
    <div style="flex:1; min-width:0; display:flex; flex-direction:column;">
      
      <!-- TOP BAR -->
      <div style="position:sticky; top:0; z-index:50; background:rgba(248,244,236,0.92); backdrop-filter:blur(8px); border-bottom:1px solid rgba(31,41,37,0.08); padding:16px clamp(16px,3vw,32px); display:flex; align-items:center; gap:16px;">
        <button id="open-mobile-drawer" class="nav-mobile-only" aria-label="Menu" style="width:40px; height:40px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.1); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div style="flex:1; min-width:0;">
          <div style="font-size:12px; color:#5a655f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Espace ANB / <span id="breadcrumb-page-label">Tableau de bord</span></div>
          <div id="title-page-label" style="font-size:17px; font-weight:800; color:#1F2925; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Tableau de bord</div>
        </div>
        <div class="nav-desktop-only" style="flex:1; max-width:340px; position:relative;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5a655f" stroke-width="1.8" style="position:absolute; left:14px; top:50%; transform:translateY(-50%);"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
          <input id="global-search-input" placeholder="Recherche globale…" style="width:100%; padding:11px 16px 11px 40px; border-radius:999px; border:1.5px solid #e3dccb; background:#FFFFFF; font-size:13.5px;" />
        </div>
        <button aria-label="Notifications" style="position:relative; width:40px; height:40px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.08); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="1.7"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 01-3.4 0"></path></svg>
          <span style="position:absolute; top:6px; right:7px; width:8px; height:8px; border-radius:50%; background:#E97824; border:1.5px solid #FFFFFF;"></span>
        </button>
        <button class="nav-desktop-only" aria-label="Aide" style="width:40px; height:40px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.08); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1F2925" stroke-width="1.7"><circle cx="12" cy="12" r="9"></circle><path d="M9.5 9.5a2.5 2.5 0 014.9.8c0 1.7-2.4 1.8-2.4 3.7"></path><circle cx="12" cy="17.2" r="0.4" fill="#1F2925"></circle></svg>
        </button>
        <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824); flex-shrink:0;"></div>
      </div>

      <!-- VIEWS CONTAINER -->
      <div style="flex:1; padding:clamp(18px,3vw,32px);">
        
        <!-- DASHBOARD VIEW -->
        <section id="view-dashboard" class="hidden fade-in">
          <DashboardCore userName={user.nom} role={user.role} />
        </section>

        <!-- ACTUALITES VIEW -->
        <ViewActualites authorName={user.nom} />

        <!-- GALERIE VIEW -->
        <ViewGalerie />

        <!-- EQUIPE VIEW -->
        <ViewEquipe />

        <!-- CONTENUS & VALIDATIONS — vue partagée avec /superadmin depuis
             que l'API accepte aussi 'admin' (workflow éditorial). -->
        <ViewValidations />

        <!-- EVENEMENTS VIEW -->
        <ViewEvenements />

        <!-- INSCRIPTIONS VIEW -->
        <ViewInscriptions />

        <!-- RECENSEMENT VIEW -->
        <ViewRecensement />

        <!-- MESSAGES VIEW -->
        <ViewMessages />


        <!-- STATISTIQUES VIEW — structure restaurée sur la maquette
             d'origine (commit fa971e8 : période + 4 cartes + "Visites par
             semaine"), après l'audit Git ayant confirmé la dérive
             introduite par f7c44fe (page devenue une redite du Dashboard).
             Même structure et mêmes définitions que Statistiques globales
             Super Admin (superadmin.astro, non modifié ici). -->
        <section id="view-stats" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px;">
            <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
              <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Statistiques</h1>
              <div style="display:flex; gap:8px; flex-wrap:wrap;" class="stats-period-container">
                <!-- Period options -->
              </div>
            </div>
            <p style="font-size:12.5px; color:#9aa39c; margin:0;">Basé uniquement sur les données de la plateforme — aucun outil de mesure d'audience (pages vues, visiteurs) n'est branché sur le site pour l'instant.</p>

            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px;">
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:8px;">
                <div style="font-size:22px; font-weight:800; color:#9aa39c;">—</div>
                <div style="font-size:13px; color:#5a655f;">Visites du site</div>
                <span style="align-self:flex-start; background:rgba(31,41,37,0.08); color:#5a655f; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;">Bientôt disponible</span>
              </div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stat-period-inscriptions" style="font-size:22px; font-weight:800; color:#176B4D;">—</div><div style="font-size:13px; color:#5a655f;">Inscriptions aux événements</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stat-period-adhesions" style="font-size:22px; font-weight:800; color:#E97824;">—</div><div style="font-size:13px; color:#5a655f;">Nouvelles personnes recensées</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:8px;">
                <div style="font-size:22px; font-weight:800; color:#9aa39c;">—</div>
                <div style="font-size:13px; color:#5a655f;">Évolution sur la période</div>
                <span style="align-self:flex-start; background:rgba(31,41,37,0.08); color:#5a655f; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;">Bientôt disponible</span>
              </div>
            </div>

            <div style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:10px;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
                <h3 style="font-size:15px; font-weight:700; color:#1F2925; margin:0;">Visites par semaine</h3>
                <span style="background:rgba(31,41,37,0.08); color:#5a655f; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;">Bientôt disponible</span>
              </div>
              <p style="font-size:13px; color:#9aa39c; margin:0;">Nécessite un outil de mesure d'audience — aucun n'est branché sur le site pour l'instant.</p>
            </div>
          </div>
        </section>

        <!-- MON PROFIL VIEW -->
        <section id="view-profil" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px; max-width:600px;">
            <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Mon profil</h1>
            <div style="background:#FFFFFF; border-radius:20px; padding:26px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:16px;">
              <div style="display:flex; align-items:center; gap:16px;">
                <div style="width:56px; height:56px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824);"></div>
                <div>
                  <div style="font-size:16px; font-weight:700; color:#1F2925;">{user.nom}</div>
                  <div style="font-size:13px; color:#5a655f;">{roleLabel}</div>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nom complet</label>
                <input id="profile-form-name" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" value={user.nom} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">E-mail</label>
                <input id="profile-form-email" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="vous@exemple.com" value={user.email} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Rôle</label>
                <input readonly style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px; color:#9aa39c;" value={roleLabel} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Laisser vide pour ne pas changer" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Confirmer le nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password-confirm" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Ressaisir le mot de passe" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password-confirm" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <button id="save-profile-btn" style="align-self:flex-start; background:#176B4D; color:#FFFFFF; border:none; padding:12px 24px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Enregistrer</button>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>

  <!-- FLOATING CREATE BUTTON -->
  <button id="mobile-fab-btn" class="nav-mobile-only" aria-label="Créer" style="position:fixed; bottom:26px; right:22px; z-index:120; width:60px; height:60px; border-radius:50%; background:#E97824; border:none; color:#FFFFFF; font-size:28px; font-weight:700; cursor:pointer; box-shadow:0 14px 30px rgba(233,120,36,0.4); display:flex; align-items:center; justify-content:center;">+</button>

  <script>
    import { createAdminContent, eventBucket } from '../lib/adminContent.js';
    import { createDashboardCore } from '../lib/dashboardCore.js';

    // Vues Actualités / Événements / Messages : markup dans
    // src/components/admin/View*.astro, logique dans lib/adminContent.js —
    // partagés à l'identique avec /superadmin.
    const content = createAdminContent({
      goPage: (page) => goPage(page),
      getBadgeHtml: (label, tone) => getBadgeHtml(label, tone),
      onViewRegistrants: (eventId) => {
        content.state.pendingInscriptionsEventId = eventId;
        goPage('inscriptions');
      },
    });

    // Dashboard : markup dans src/components/admin/DashboardCore.astro,
    // logique dans lib/dashboardCore.js — partagé à l'identique avec
    // /superadmin (role='admin' ici, pas de section Gouvernance).
    const dashboard = createDashboardCore({
      goPage: (page) => goPage(page),
      getBadgeHtml: (label, tone) => getBadgeHtml(label, tone),
      role: 'admin',
    });

    // State management
    const state = {
      user: 'admin',
      page: 'dashboard',
      statsPeriod: '30 jours',
    };

    const navigationItems = [
      { key: 'dashboard', label: 'Tableau de bord' },
      { key: 'actualites', label: 'Actualités' },
      { key: 'galerie', label: 'Galerie' },
      { key: 'equipe', label: 'Équipe' },
      { key: 'contenus', label: 'Contenus & validations' },
      { key: 'evenements', label: 'Événements' },
      { key: 'inscriptions', label: 'Inscriptions' },
      { key: 'recensement', label: 'Recensement' },
      { key: 'messages', label: 'Messages' },
      { key: 'stats', label: 'Statistiques' },
      { type: 'separator' },
      { key: 'profil', label: 'Mon profil' }
    ];

    const svgMap = {
      dashboard: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="8" height="8" rx="2"></rect><rect x="13" y="3" width="8" height="8" rx="2"></rect><rect x="3" y="13" width="8" height="8" rx="2"></rect><rect x="13" y="13" width="8" height="8" rx="2"></rect></svg>`,
      actualites: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="7" y1="9" x2="17" y2="9"></line><line x1="7" y1="13" x2="17" y2="13"></line><line x1="7" y1="17" x2="12" y2="17"></line></svg>`,
      galerie: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>`,
      equipe: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3.2"></circle><circle cx="16.5" cy="9" r="2.4"></circle><path d="M3.5 19c0-3.3 2.6-5.6 5.9-5.6s5.9 2.3 5.9 5.6"></path><path d="M14.5 13.7c2.6 0.2 4.3 2.2 4.3 5"></path></svg>`,
      contenus: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>`,
      evenements: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="3" x2="8" y2="7"></line><line x1="16" y1="3" x2="16" y2="7"></line></svg>`,
      inscriptions: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>`,
      recensement: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path></svg>`,
      messages: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 6l9 6 9-6"></path></svg>`,
      stats: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20V10M12 20V4M20 20v-7"></path></svg>`,
      profil: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.4"></circle><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"></path></svg>`
    };

    // Arrays populated dynamically via API
    let newsArticles = [];
    let eventsAdmin = [];
    let registrants = [];
    let messages = [];
    // Les 4 KPI communs avec le Super Admin (voir lib/stats.js) : calculés
    // côté serveur par /api/admin/kpis, plus jamais dérivés en filtrant les
    // tableaux ci-dessus dans le navigateur.
    let commonKpis = { evenements_a_venir: 0, inscriptions_evenements: 0, actualites_publiees: 0, personnes_recensees: 0 };

    async function fetchAdminData() {
      try {
        const [response, kpisResponse] = await Promise.all([
          fetch('/api/admin/data'),
          fetch('/api/admin/kpis'),
        ]);
        if (!response.ok) throw new Error("Erreur de récupération des données");
        if (!kpisResponse.ok) throw new Error("Erreur de récupération des statistiques");

        const data = await response.json();
        commonKpis = await kpisResponse.json();

        newsArticles = data.actualites;
        eventsAdmin = data.evenements;
        registrants = data.inscriptions;
        messages = data.messages;

        // Les vues partagées travaillent sur leur propre copie des données
        // (dont Recensement, désormais mutualisée avec /superadmin).
        content.setData(data);
        // commonKpis (kpisResponse) n'est plus consommé par la page
        // Statistiques depuis sa restauration sur la structure période +
        // 4 cartes (voir loadStats() plus bas, qui appelle /api/admin/stats
        // à la place) — laissé en l'état, fetch inoffensif, pour ne pas
        // toucher au reste de fetchAdminData() hors du périmètre de cette
        // correction. Le dashboard a son propre chargement indépendant via
        // dashboard.load() (lib/dashboardCore.js).

        // Re-render current page
        renderPageDetails(state.page);

      } catch (err) {
        console.error("Erreur D1 : ", err);
      }
    }

    function getBadgeHtml(label, tone) {
      const map = {
        g: { bg: 'rgba(23,107,77,0.12)', color: '#176B4D' },
        o: { bg: 'rgba(233,120,36,0.16)', color: '#B75E12' },
        r: { bg: 'rgba(177,69,36,0.13)', color: '#B14524' },
        n: { bg: 'rgba(31,41,37,0.08)', color: '#5a655f' }
      };
      const c = map[tone] || map.n;
      return `<span style="background:${c.bg}; color:${c.color}; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:700;">${label}</span>`;
    }

    function goPage(pageKey) {
      state.page = pageKey;
      
      document.querySelectorAll('.sidebar-link').forEach(link => {
        if (link.dataset.page === pageKey) {
          link.classList.add('active-nav-btn');
        } else {
          link.classList.remove('active-nav-btn');
        }
      });

      const pageTitleMap = {
        dashboard: 'Tableau de bord', actualites: 'Actualités', 'actualites-new': 'Nouvelle actualité',
        galerie: 'Galerie', 'galerie-new': 'Ajouter un média',
        equipe: 'Équipe', 'equipe-new': 'Ajouter un membre',
        contenus: 'Contenus & validations',
        evenements: 'Événements', 'evenements-new': 'Créer un événement',
        inscriptions: 'Inscriptions', recensement: 'Recensement',
        messages: 'Messages', stats: 'Statistiques', profil: 'Mon profil'
      };

      document.getElementById('breadcrumb-page-label').textContent = pageTitleMap[pageKey] || '';
      document.getElementById('title-page-label').textContent = pageTitleMap[pageKey] || '';

      document.querySelectorAll('section[id^="view-"]').forEach(sec => {
        sec.classList.add('hidden');
      });
      
      const targetView = document.getElementById(`view-${pageKey}`);
      if (targetView) {
        targetView.classList.remove('hidden');
        // Retient l'onglet courant pour qu'un rechargement de page (F5) y
        // revienne au lieu de repartir sur Tableau de bord.
        try { sessionStorage.setItem('admin-current-page', pageKey); } catch {}
      }

      document.getElementById('mobile-sidebar-drawer').classList.add('hidden');

      renderPageDetails(pageKey);
    }



    // Redimensionne + réencode en JPEG côté navigateur avant l'envoi : évite
    // d'envoyer des photos de plusieurs Mo telles quelles (coût R2, lenteur,
    // et certains antivirus/proxys cassent les gros uploads multipart).


    function generateNav() {
      const desktopContainer = document.getElementById('desktop-sidebar-nav');
      const mobileContainer = document.getElementById('mobile-sidebar-nav');

      desktopContainer.innerHTML = '';
      mobileContainer.innerHTML = '';

      function createLink(item) {
        const link = document.createElement('a');
        link.className = 'sidebar-link';
        link.dataset.page = item.key;
        link.style.cursor = 'pointer';
        const svgContent = svgMap[item.key] || '';
        link.innerHTML = `${svgContent}<span>${item.label}</span>`;
        link.addEventListener('click', () => {
          // Une entrée de menu ouvre toujours un formulaire vierge : sans ça,
          // on hériterait du contenu d'une modification en cours.
          if (item.key === 'actualites-new') content.resetNewsForm();
          if (item.key === 'evenements-new') content.resetEventForm();
          goPage(item.key);
        });
        return link;
      }

      navigationItems.forEach(item => {
        if (item.type === 'separator') {
          const sep = document.createElement('div');
          sep.style.cssText = 'height:1px; background:rgba(31,41,37,0.07); margin:10px 6px;';
          desktopContainer.appendChild(sep);
          mobileContainer.appendChild(sep.cloneNode(true));
        } else {
          desktopContainer.appendChild(createLink(item));
          mobileContainer.appendChild(createLink(item));
        }
      });
    }

    function renderPageDetails(pageKey) {
      if (pageKey === 'dashboard') {
        dashboard.load();
      } else if (pageKey === 'actualites') {
        content.renderActualites();
      } else if (pageKey === 'galerie') {
        content.renderGalerie();
      } else if (pageKey === 'equipe') {
        content.renderEquipe();
      } else if (pageKey === 'contenus') {
        content.loadValidations();
      } else if (pageKey === 'evenements') {
        content.renderEvenements();
      } else if (pageKey === 'inscriptions') {
        content.renderInscriptions();
      } else if (pageKey === 'recensement') {
        content.renderRecensement();
      } else if (pageKey === 'messages') {
        content.renderMessages();
      } else if (pageKey === 'stats') {
        loadStats();
      }
    }

    // 1. Dashboard — vue partagée, voir lib/dashboardCore.js
    // (dashboard.load(), appelée depuis renderPageDetails()).

    // 2. Actualités

    // 3. Événements

    // 4. Inscriptions — vue partagée, voir lib/adminContent.js
    // (content.renderInscriptions(), appelée depuis renderPageDetails()).

    // Recensement render
    // 6. Recensement — vue partagée, voir lib/adminContent.js
    // (content.renderRecensement(), appelée depuis renderPageDetails()).

    // 7. Messages

    // 10. Statistiques — structure restaurée sur la maquette d'origine
    // (audit Git : commit fa971e8), mêmes définitions et même
    // comportement que Statistiques globales Super Admin
    // (superadmin.astro, non modifié). "Inscriptions aux événements" et
    // "Nouvelles personnes recensées" sont les seules données réelles,
    // filtrées par la période sélectionnée — via /api/admin/stats
    // (lib/stats.js getPeriodStats(), même source que côté Super Admin).
    // "Visites du site" / "Évolution sur la période" / "Visites par
    // semaine" restent "Bientôt disponible" : aucun outil d'analytics
    // n'est branché sur le site, aucun chiffre n'est inventé.
    const STATS_PERIODS = [
      { label: '7 jours', days: '7' },
      { label: '30 jours', days: '30' },
      { label: '3 mois', days: '90' },
      { label: '1 an', days: '365' }
    ];

    function renderStatsPeriodButtons() {
      const periodsWrapper = document.querySelector('.stats-period-container');
      periodsWrapper.innerHTML = '';
      STATS_PERIODS.forEach(p => {
        const btn = document.createElement('button');
        btn.style.cssText = `border:2px solid #176B4D; padding:8px 16px; border-radius:999px; font-weight:700; font-size:13px; cursor:pointer;`;
        if (state.statsPeriod === p.label) {
          btn.style.background = '#176B4D';
          btn.style.color = '#FFFFFF';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = '#176B4D';
        }
        btn.textContent = p.label;
        btn.addEventListener('click', () => {
          state.statsPeriod = p.label;
          loadStats();
        });
        periodsWrapper.appendChild(btn);
      });
    }

    async function loadStats() {
      renderStatsPeriodButtons();
      const periodDef = STATS_PERIODS.find(p => p.label === state.statsPeriod) || STATS_PERIODS[1];
      try {
        const res = await fetch(`/api/admin/stats?period=${periodDef.days}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');
        document.getElementById('stat-period-inscriptions').textContent = data.period_stats.inscriptions;
        document.getElementById('stat-period-adhesions').textContent = data.period_stats.adhesions;
      } catch (err) {
        document.getElementById('stat-period-inscriptions').innerHTML = '—';
        document.getElementById('stat-period-adhesions').innerHTML = '—';
      }
    }

    // MAIN DOM LISTENERS AND SELECTORS SAFELY WRAPPED
    document.addEventListener('DOMContentLoaded', async () => {
      // Nav structure init
      generateNav();

      // Câblage des vues partagées (upload, formulaires) — une seule fois.
      content.wire();

      // Load D1 data
      await fetchAdminData();
      
      // Open dashboard (ou l'onglet où on était avant un rechargement)
      let initialPage = 'dashboard';
      try {
        const saved = sessionStorage.getItem('admin-current-page');
        if (saved && document.getElementById(`view-${saved}`)) initialPage = saved;
      } catch {}
      goPage(initialPage);

      // Logout handler
      document.querySelectorAll('.logout-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          await fetch('/api/logout', { method: 'POST' });
          window.location.href = '/connexion';
        });
      });

      // Afficher/masquer un champ mot de passe (délégation).
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.toggle-password-visibility-btn');
        if (!btn) return;
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.setAttribute('aria-label', showing ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
      });

      // Mon profil — route commune à tous les rôles (api/superadmin/profile.js)
      document.getElementById('save-profile-btn')?.addEventListener('click', async () => {
        const nom = document.getElementById('profile-form-name').value.trim();
        const email = document.getElementById('profile-form-email').value.trim();
        const password = document.getElementById('profile-form-password').value;
        const passwordConfirm = document.getElementById('profile-form-password-confirm').value;

        if (password && password !== passwordConfirm) {
          alert('Les deux mots de passe ne correspondent pas.');
          return;
        }

        try {
          const res = await fetch('/api/superadmin/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nom, email, password: password || undefined })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          alert('Profil enregistré !');
          document.getElementById('profile-form-password').value = '';
          document.getElementById('profile-form-password-confirm').value = '';
          const sidebarName = document.getElementById('sidebar-user-name');
          if (sidebarName) sidebarName.textContent = nom;
        } catch (err) {
          alert(err.message);
        }
      });

      // Mobile Drawer actions
      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const mobileDrawer = document.getElementById('mobile-sidebar-drawer');

      if (openDrawerBtn && mobileDrawer) {
        openDrawerBtn.addEventListener('click', () => {
          mobileDrawer.classList.remove('hidden');
        });
      }
      if (closeDrawerBtn && mobileDrawer) {
        closeDrawerBtn.addEventListener('click', () => {
          mobileDrawer.classList.add('hidden');
        });
      }

      // Recensement (recherche, onglets, export CSV) : câblé par
      // content.wire() ci-dessus (lib/adminContent.js, wireRecensement()).

      // Mobile FAB Trigger
      document.getElementById('mobile-fab-btn')?.addEventListener('click', () => {
        content.resetNewsForm();
        goPage('actualites-new');
      });

      // Raccourcis « Créer » présents dans les vues : le formulaire doit
      // toujours s'ouvrir vierge. (La navigation elle-même est prise en
      // charge par .nav-trigger-btn plus bas.)
      document.querySelectorAll('.btn-create-news').forEach((btn) => {
        btn.addEventListener('click', () => content.resetNewsForm());
      });
      document.querySelectorAll('.btn-create-event').forEach((btn) => {
        btn.addEventListener('click', () => content.resetEventForm());
      });
      document.querySelectorAll('.btn-create-galerie').forEach((btn) => {
        btn.addEventListener('click', () => content.resetGalerieForm());
      });
      document.querySelectorAll('.btn-create-equipe').forEach((btn) => {
        btn.addEventListener('click', () => content.resetEquipeForm());
      });

      // General nav triggers (buttons)
      document.querySelectorAll('.nav-trigger-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          goPage(btn.dataset.page);
        });
      });
    });
  </script>

</body>
</html>
