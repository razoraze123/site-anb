        <!-- MESSAGES VIEW -->
        <ViewMessages />

        <!-- PAGES DU SITE VIEW -->
        <section id="view-pages" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px;">
            <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Pages du site</h1>
            <div style="background:#FFFFFF; border-radius:20px; padding:8px; box-shadow:0 8px 24px rgba(31,41,37,0.05);" id="site-pages-container">
              <!-- list -->
            </div>
          </div>
        </section>

        <!-- STATISTIQUES VIEW -->
        <section id="view-stats" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px;">
            <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Statistiques</h1>
            <p style="font-size:12.5px; color:#9aa39c; margin:0;">Basé uniquement sur les données de la plateforme — aucun outil de mesure d'audience (pages vues, visiteurs) n'est branché sur le site pour l'instant.</p>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px;">
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stats-articles-publies" style="font-size:22px; font-weight:800; color:#176B4D;">—</div><div style="font-size:13px; color:#5a655f;">Articles publiés</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stats-inscriptions-confirmees" style="font-size:22px; font-weight:800; color:#E97824;">—</div><div style="font-size:13px; color:#5a655f;">Inscriptions confirmées</div></div>
              <div id="stats-recensement-card" style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stats-recensement" style="font-size:22px; font-weight:800; color:#176B4D;">—</div><div style="font-size:13px; color:#5a655f;">Membres recensés</div></div>
              <div style="background:#FFFFFF; border-radius:16px; padding:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05);"><div id="stats-messages-a-traiter" style="font-size:22px; font-weight:800; color:#E97824;">—</div><div style="font-size:13px; color:#5a655f;">Messages à traiter</div></div>
            </div>

            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px;">
              <div style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05);">
                <h3 style="font-size:15px; font-weight:700; color:#1F2925; margin:0 0 14px;">Prochains événements</h3>
                <div id="stats-upcoming-events"></div>
              </div>
              <div style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05);">
                <h3 style="font-size:15px; font-weight:700; color:#1F2925; margin:0 0 14px;">Messages récents à traiter</h3>
                <div id="stats-recent-messages"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- MON PROFIL VIEW -->
        <section id="view-profil" class="hidden fade-in">
          <div style="display:flex; flex-direction:column; gap:20px; max-width:600px;">
            <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Mon profil</h1>
            <div style="background:#FFFFFF; border-radius:20px; padding:26px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:16px;">
              <div style="display:flex; align-items:center; gap:16px;">
                <div style="width:56px; height:56px; border-radius:50%; background:linear-gradient(150deg,#176B4D,#E97824);"></div>
                <div>
                  <div style="font-size:16px; font-weight:700; color:#1F2925;">{user.nom}</div>
                  <div style="font-size:13px; color:#5a655f;">{roleLabel}</div>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nom complet</label>
                <input id="profile-form-name" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" value={user.nom} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">E-mail</label>
                <input id="profile-form-email" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="vous@anb-bordeaux.fr" value={user.email} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Rôle</label>
                <input readonly style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px; color:#9aa39c;" value={roleLabel} />
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Laisser vide pour ne pas changer" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <div>
                <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Confirmer le nouveau mot de passe</label>
                <div style="position:relative;">
                  <input id="profile-form-password-confirm" type="password" style="width:100%; padding:12px 44px 12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px;" placeholder="Ressaisir le mot de passe" />
                  <button type="button" class="toggle-password-visibility-btn" data-target="profile-form-password-confirm" aria-label="Afficher le mot de passe" style="position:absolute; top:50%; right:10px; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#5a655f; display:flex;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                </div>
              </div>
              <button id="save-profile-btn" style="align-self:flex-start; background:#176B4D; color:#FFFFFF; border:none; padding:12px 24px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Enregistrer</button>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>

  <!-- FLOATING CREATE BUTTON -->
  <button id="mobile-fab-btn" class="nav-mobile-only" aria-label="Créer" style="position:fixed; bottom:26px; right:22px; z-index:120; width:60px; height:60px; border-radius:50%; background:#E97824; border:none; color:#FFFFFF; font-size:28px; font-weight:700; cursor:pointer; box-shadow:0 14px 30px rgba(233,120,36,0.4); display:flex; align-items:center; justify-content:center;">+</button>

  <script>
    import { createAdminContent } from '../lib/adminContent.js';

    // Vues Actualités / Événements / Messages : markup dans
    // src/components/admin/View*.astro, logique dans lib/adminContent.js —
    // partagés à l'identique avec /superadmin.
    const content = createAdminContent({
      goPage: (page) => goPage(page),
      getBadgeHtml: (label, tone) => getBadgeHtml(label, tone),
      onViewRegistrants: (eventId) => {
        pendingInscriptionsEventId = eventId;
        goPage('inscriptions');
      },
    });

    // State management
    const state = {
      user: 'admin',
      page: 'dashboard',
      recensementFilter: 'Tous'
    };

    const navigationItems = [
      { key: 'dashboard', label: 'Tableau de bord' },
      { key: 'actualites', label: 'Actualités' },
      { key: 'evenements', label: 'Événements' },
      { key: 'inscriptions', label: 'Inscriptions' },
      { key: 'recensement', label: 'Recensement' },
      { key: 'messages', label: 'Messages' },
      { key: 'pages', label: 'Pages du site' },
      { key: 'stats', label: 'Statistiques' },
      { type: 'separator' },
      { key: 'profil', label: 'Mon profil' }
    ];

    const svgMap = {
      dashboard: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="8" height="8" rx="2"></rect><rect x="13" y="3" width="8" height="8" rx="2"></rect><rect x="3" y="13" width="8" height="8" rx="2"></rect><rect x="13" y="13" width="8" height="8" rx="2"></rect></svg>`,
      actualites: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="7" y1="9" x2="17" y2="9"></line><line x1="7" y1="13" x2="17" y2="13"></line><line x1="7" y1="17" x2="12" y2="17"></line></svg>`,
      evenements: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="3" x2="8" y2="7"></line><line x1="16" y1="3" x2="16" y2="7"></line></svg>`,
      inscriptions: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>`,
      recensement: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path d="M16 3.13a4 4 0 010 7.75"></path></svg>`,
      messages: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 6l9 6 9-6"></path></svg>`,
      pages: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 3h8l4 4v14a1 1 0 01-1 1H7a1 1 0 01-1-1V4a1 1 0 017-1z"></path><path d="M15 3v4h4"></path></svg>`,
      stats: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20V10M12 20V4M20 20v-7"></path></svg>`,
      profil: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.4"></circle><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"></path></svg>`
    };

    // Arrays populated dynamically via API
    let priorityItems = [];
    let newsArticles = [];
    let eventsAdmin = [];
    let registrants = [];
    let pendingInscriptionsEventId = null;
    let messages = [];
    let recensementList = [];
    let recensementSearch = '';

    async function fetchAdminData() {
      try {
        const response = await fetch('/api/admin/data');
        if (!response.ok) throw new Error("Erreur de récupération des données");
        
        const data = await response.json();
        
        newsArticles = data.actualites;
        eventsAdmin = data.evenements;
        registrants = data.inscriptions;
        messages = data.messages;
        recensementList = data.recensement || [];

        // Les vues partagées travaillent sur leur propre copie des données.
        content.setData(data);

        // Populate statistics indicators
        document.getElementById('stat-events-count').textContent = eventsAdmin.length;
        document.getElementById('stat-news-count').textContent = newsArticles.filter(n => n.status === 'Publié').length;
        document.getElementById('stat-members-count').textContent = registrants.filter(r => r.status === 'Confirmé').length;
        document.getElementById('stat-census-count').textContent = recensementList.length;

        // Update priority items
        priorityItems = [];

        messages.filter(m => m.status === 'Non lu' || m.status === 'À traiter').forEach(m => {
          priorityItems.push({
            id: m.id,
            name: m.from_name,
            type: m.subject,
            date: 'Reçu',
            status: m.status,
            tone: 'o',
            avatarBg: 'linear-gradient(150deg,#E97824,#1F2925)',
            action: 'messages'
          });
        });

        // Encart « prochain événement » du tableau de bord. (L'encart
        // équivalent de la vue Événements est géré par le module partagé.)
        const nextEvent = eventsAdmin.find(e => e.tab === 'À venir');
        if (nextEvent) {
          document.getElementById('next-event-title').textContent = nextEvent.title;
          document.getElementById('next-event-date').textContent = nextEvent.date;
          document.getElementById('next-event-place').textContent = nextEvent.place;
        }

        // Re-render current page
        renderPageDetails(state.page);

      } catch (err) {
        console.error("Erreur D1 : ", err);
      }
    }

    function getBadgeHtml(label, tone) {
      const map = {
        g: { bg: 'rgba(23,107,77,0.12)', color: '#176B4D' },
        o: { bg: 'rgba(233,120,36,0.16)', color: '#B75E12' },
        r: { bg: 'rgba(177,69,36,0.13)', color: '#B14524' },
        n: { bg: 'rgba(31,41,37,0.08)', color: '#5a655f' }
      };
      const c = map[tone] || map.n;
      return `<span style="background:${c.bg}; color:${c.color}; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:700;">${label}</span>`;
    }

    function goPage(pageKey) {
      state.page = pageKey;
      
      document.querySelectorAll('.sidebar-link').forEach(link => {
        if (link.dataset.page === pageKey) {
          link.classList.add('active-nav-btn');
        } else {
          link.classList.remove('active-nav-btn');
        }
      });

      const pageTitleMap = {
        dashboard: 'Tableau de bord', actualites: 'Actualités', 'actualites-new': 'Nouvelle actualité',
        evenements: 'Événements', 'evenements-new': 'Créer un événement',
        inscriptions: 'Inscriptions', recensement: 'Recensement',
        messages: 'Messages', pages: 'Pages du site', stats: 'Statistiques', profil: 'Mon profil'
      };

      document.getElementById('breadcrumb-page-label').textContent = pageTitleMap[pageKey] || '';
      document.getElementById('title-page-label').textContent = pageTitleMap[pageKey] || '';

      document.querySelectorAll('section[id^="view-"]').forEach(sec => {
        sec.classList.add('hidden');
      });
      
      const targetView = document.getElementById(`view-${pageKey}`);
      if (targetView) {
        targetView.classList.remove('hidden');
        // Retient l'onglet courant pour qu'un rechargement de page (F5) y
        // revienne au lieu de repartir sur Tableau de bord.
        try { sessionStorage.setItem('admin-current-page', pageKey); } catch {}
      }

      document.getElementById('mobile-sidebar-drawer').classList.add('hidden');

      renderPageDetails(pageKey);
    }



    // Redimensionne + réencode en JPEG côté navigateur avant l'envoi : évite
    // d'envoyer des photos de plusieurs Mo telles quelles (coût R2, lenteur,
    // et certains antivirus/proxys cassent les gros uploads multipart).


    function generateNav() {
      const desktopContainer = document.getElementById('desktop-sidebar-nav');
      const mobileContainer = document.getElementById('mobile-sidebar-nav');

      desktopContainer.innerHTML = '';
      mobileContainer.innerHTML = '';

      function createLink(item) {
        const link = document.createElement('a');
        link.className = 'sidebar-link';
        link.dataset.page = item.key;
        link.style.cursor = 'pointer';
        const svgContent = svgMap[item.key] || '';
        link.innerHTML = `${svgContent}<span>${item.label}</span>`;
        link.addEventListener('click', () => {
          // Une entrée de menu ouvre toujours un formulaire vierge : sans ça,
          // on hériterait du contenu d'une modification en cours.
          if (item.key === 'actualites-new') content.resetNewsForm();
          if (item.key === 'evenements-new') content.resetEventForm();
          goPage(item.key);
        });
        return link;
      }

      navigationItems.forEach(item => {
        if (item.type === 'separator') {
          const sep = document.createElement('div');
          sep.style.cssText = 'height:1px; background:rgba(31,41,37,0.07); margin:10px 6px;';
          desktopContainer.appendChild(sep);
          mobileContainer.appendChild(sep.cloneNode(true));
        } else {
          desktopContainer.appendChild(createLink(item));
          mobileContainer.appendChild(createLink(item));
        }
      });
    }

    function renderPageDetails(pageKey) {
      if (pageKey === 'dashboard') {
        renderDashboard();
      } else if (pageKey === 'actualites') {
        content.renderActualites();
      } else if (pageKey === 'evenements') {
        content.renderEvenements();
      } else if (pageKey === 'inscriptions') {
        renderInscriptions();
      } else if (pageKey === 'recensement') {
        renderRecensement();
      } else if (pageKey === 'messages') {
        content.renderMessages();
      } else if (pageKey === 'pages') {
        renderPages();
      } else if (pageKey === 'stats') {
        renderStats();
      }
    }

    // 1. Dashboard
    function renderDashboard() {
      const container = document.getElementById('priority-items-container');
      container.innerHTML = '';
      
      if (priorityItems.length === 0) {
        container.innerHTML = '<div style="padding: 16px; text-align: center; color: var(--color-muted-text); font-size: 13.5px;">✓ Parfait ! Aucun message en attente.</div>';
        return;
      }

      priorityItems.forEach(it => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:14px; padding:14px 6px; border-bottom:1px solid rgba(31,41,37,0.06); flex-wrap:wrap;';
        row.innerHTML = `
          <div style="width:36px; height:36px; border-radius:50%; background:${it.avatarBg}; flex-shrink:0;"></div>
          <div style="flex:1; min-width:180px;">
            <div style="font-size:14px; font-weight:700; color:#1F2925;">${it.name} — ${it.type}</div>
            <div style="font-size:12.5px; color:#5a655f;">${it.date}</div>
          </div>
          ${getBadgeHtml(it.status, it.tone)}
          <a class="priority-item-action" style="font-size:13.5px; font-weight:700; color:#176B4D; cursor:pointer; text-decoration: underline;">Traiter →</a>
        `;
        row.querySelector('.priority-item-action').addEventListener('click', () => goPage(it.action));
        container.appendChild(row);
      });

      renderDashboardCalendar();
    }

    const MONTHS_FR = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
    const MONTHS_FR_ABBR = ['janv', 'févr', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'];

    // Parse dates au format libre "20 sept. 2026" saisi par l'admin ; renvoie
    // null si le format ne colle pas (ex: "juin 2026", "à définir").
    function parseFrDate(str) {
      const m = /^(\d{1,2})\s+([^\s.]+)\.?\s+(\d{4})$/.exec((str || '').trim().toLowerCase());
      if (!m) return null;
      const monthIdx = MONTHS_FR_ABBR.findIndex(abbr => m[2].startsWith(abbr));
      if (monthIdx === -1) return null;
      return { day: parseInt(m[1], 10), month: monthIdx, year: parseInt(m[3], 10) };
    }

    function renderDashboardCalendar() {
      const calendarWrapper = document.getElementById('dashboard-calendar');
      const dayHeaders = Array.from(calendarWrapper.querySelectorAll('div[style*="font-size:11px"]'));
      calendarWrapper.innerHTML = '';
      dayHeaders.forEach(dh => calendarWrapper.appendChild(dh));

      const today = new Date();
      const year = today.getFullYear();
      const month = today.getMonth();
      const todayDate = today.getDate();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7; // 0 = lundi

      const monthLabel = document.getElementById('calendar-month-label');
      if (monthLabel) monthLabel.textContent = `Calendrier — ${MONTHS_FR[month]} ${year}`;

      const eventDays = new Set();
      eventsAdmin.forEach(e => {
        const parsed = parseFrDate(e.date);
        if (parsed && parsed.year === year && parsed.month === month) eventDays.add(parsed.day);
      });

      for (let i = 0; i < firstWeekday; i++) {
        calendarWrapper.appendChild(document.createElement('div'));
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const isToday = d === todayDate;
        const hasEvent = eventDays.has(d);
        const cell = document.createElement('div');
        cell.style.cssText = `aspect-ratio:1; display:flex; align-items:center; justify-content:center; border-radius:8px; font-size:12px; font-weight:600; background:${isToday ? '#E97824' : (hasEvent ? 'rgba(23,107,77,0.12)' : 'transparent')}; color:${isToday ? '#FFFFFF' : (hasEvent ? '#176B4D' : '#1F2925')};`;
        cell.textContent = d;
        calendarWrapper.appendChild(cell);
      }
    }

    // 2. Actualités

    // 3. Événements

    // 4. Inscriptions
    function renderInscriptions() {
      const select = document.getElementById('registrants-event-select');
      
      // Update dropdown options
      const currentVal = select.value;
      select.innerHTML = '';
      eventsAdmin.forEach(e => {
        const opt = document.createElement('option');
        opt.value = e.id;
        opt.textContent = `${e.title} — ${e.date}`;
        select.appendChild(opt);
      });
      if (pendingInscriptionsEventId !== null) {
        select.value = pendingInscriptionsEventId;
        pendingInscriptionsEventId = null;
      } else if (currentVal) select.value = currentVal;
      else if (eventsAdmin.length > 0) select.value = eventsAdmin[0].id;

      const activeEventId = parseInt(select.value);
      const activeEvent = eventsAdmin.find(e => e.id === activeEventId);
      
      const countEl = document.getElementById('event-reg-count');
      const remainingEl = document.getElementById('event-remaining-places');
      
      if (activeEvent) {
        countEl.textContent = activeEvent.registered_count;
        remainingEl.textContent = activeEvent.max_places - activeEvent.registered_count;
      }

      // Filter registrants for selected event
      const container = document.getElementById('registrants-list-container');
      container.innerHTML = '';

      const filtered = registrants.filter(r => r.event_id === activeEventId);

      if (filtered.length === 0) {
        container.innerHTML = '<div style="padding: 24px; text-align: center; color: var(--color-muted-text); font-size: 13.5px;">Aucune inscription enregistrée pour cet événement.</div>';
        return;
      }

      filtered.forEach(p => {
        const tone = p.status === 'Confirmé' ? 'g' : (p.status === 'Annulé' ? 'r' : 'o');
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:16px; padding:14px 16px; border-bottom:1px solid rgba(31,41,37,0.06); flex-wrap:wrap;';
        row.innerHTML = `
          <div style="flex:1; min-width:160px; font-size:14px; font-weight:700; color:#1F2925;">${p.first_name} ${p.last_name}</div>
          <div style="flex:1; min-width:180px; font-size:13px; color:#5a655f;">${p.email}</div>
          <div style="min-width:120px; font-size:13px; color:#5a655f;">${p.phone}</div>
          ${getBadgeHtml(p.status, tone)}
        `;
        container.appendChild(row);
      });

      // Bind select change
      select.onchange = () => {
        renderInscriptions();
      };
    }

    // Recensement render
    function renderRecensement() {
      const tbody = document.getElementById('recensement-table-body');
      if (!tbody) return;

      tbody.innerHTML = '';

      // Update counters in header
      const countLabel = document.getElementById('rec-count-label');
      const benevoleLabel = document.getElementById('rec-benevole-label');
      if (countLabel) countLabel.textContent = recensementList.length;
      if (benevoleLabel) benevoleLabel.textContent = recensementList.filter(r => r.benevole).length;

      const filtered = recensementList.filter(r => {
        // Filter by tab status
        if (state.recensementFilter === 'benevole') {
          if (!r.benevole) return false;
        } else if (state.recensementFilter !== 'Tous' && r.status !== state.recensementFilter) {
          return false;
        }

        // Filter by search query
        if (recensementSearch) {
          const query = recensementSearch.toLowerCase().trim();
          const fullName = `${r.first_name} ${r.last_name}`.toLowerCase();
          return fullName.includes(query) || r.email.toLowerCase().includes(query) || (r.phone && r.phone.includes(query)) || (r.origine && r.origine.toLowerCase().includes(query));
        }

        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" style="padding:40px; text-align:center; color:#5a655f; font-size:14px;">
              Aucun membre recensé ne correspond à ces critères.
            </td>
          </tr>
        `;
        return;
      }

      filtered.forEach(r => {
        const tr = document.createElement('tr');
        tr.style.cssText = 'border-bottom:1px solid rgba(31,41,37,0.06); transition:background-color 0.15s;';
        tr.onmouseover = () => tr.style.backgroundColor = 'rgba(23,107,77,0.02)';
        tr.onmouseout = () => tr.style.backgroundColor = 'transparent';

        const statusTone = r.status === 'Étudiant' ? 'g' : 'o';
        const dateStr = r.created_at ? r.created_at.split(' ')[0] : '—';
        const benevoleHtml = r.benevole
          ? `<span style="background:rgba(233,120,36,0.12); color:#B75E12; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:700;">🤝 Oui</span>`
          : `<span style="color:#9aa39c; font-size:12px;">—</span>`;

        tr.innerHTML = `
          <td style="padding:13px 18px; font-weight:700; color:#1F2925; white-space:nowrap;">${r.first_name} ${r.last_name}</td>
          <td style="padding:13px 18px;">${getBadgeHtml(r.status, statusTone)}</td>
          <td style="padding:13px 18px; color:#5a655f; font-size:13px; max-width:140px; overflow:hidden; text-overflow:ellipsis;">${r.domaine || '—'}</td>
          <td style="padding:13px 18px;">${benevoleHtml}</td>
          <td style="padding:13px 18px; color:#5a655f; font-size:13px;">${r.email}</td>
          <td style="padding:13px 18px; color:#5a655f; font-size:13px; white-space:nowrap;">${r.phone}</td>
          <td style="padding:13px 18px; text-align:right; white-space:nowrap;">
            <span style="font-size:11.5px; color:#9aa39c; margin-right:8px;">${dateStr}</span>
            <button class="delete-rec-btn" data-id="${r.id}" style="background:transparent; border:none; color:#B14524; font-size:12.5px; font-weight:700; cursor:pointer; padding:5px 10px; border-radius:6px; transition:background-color 0.15s;">Suppr.</button>
          </td>
        `;

        // Bind delete action
        tr.querySelector('.delete-rec-btn').addEventListener('click', async (e) => {
          const id = e.target.dataset.id;
          if (confirm("Êtes-vous sûr de vouloir supprimer ce recensement ?")) {
            try {
              const res = await fetch(`/api/admin/recensement?id=${id}`, { method: 'DELETE' });
              if (!res.ok) throw new Error("Échec de la suppression");

              // Remove locally and re-render
              recensementList = recensementList.filter(item => item.id != id);
              document.getElementById('stat-census-count').textContent = recensementList.length;
              renderRecensement();
            } catch (err) {
              alert(err.message);
            }
          }
        });

        tbody.appendChild(tr);
      });
    }


    // 7. Messages

    // 9. Pages
    function renderPages() {
      const container = document.getElementById('site-pages-container');
      container.innerHTML = '';
      const pList = [
        { name: 'Accueil', modified: '12 juil. 2026', author: 'Mariama S.', status: 'Publié' },
        { name: "L'association", modified: '20 juin 2026', author: 'Nasser D.', status: 'Publié' },
        { name: 'Culture nigérienne', modified: '15 mai 2026', author: 'Fatou I.', status: 'Publié' },
        { name: 'Contact', modified: '2 avr. 2026', author: 'Mariama S.', status: 'Publié' },
        { name: 'Mentions légales', modified: '12 juil. 2026', author: 'Nasser D.', status: 'Publié' },
        { name: 'CGU', modified: '12 juil. 2026', author: 'Nasser D.', status: 'Publié' },
        { name: 'Politique de confidentialité', modified: '12 juil. 2026', author: 'Nasser D.', status: 'Publié' }
      ];

      pList.forEach(p => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; align-items:center; gap:16px; padding:16px; border-bottom:1px solid rgba(31,41,37,0.06); flex-wrap:wrap;';
        row.innerHTML = `
          <div style="flex:1; min-width:160px; font-size:14.5px; font-weight:700; color:#1F2925;">${p.name}</div>
          <div style="font-size:12.5px; color:#5a655f; min-width:120px;">Modifié le ${p.modified}</div>
          <div style="font-size:12.5px; color:#5a655f; min-width:120px;">Par ${p.author}</div>
          ${getBadgeHtml(p.status, 'g')}
        `;
        container.appendChild(row);
      });
    }

    // 10. Statistiques
    function renderStats() {
      // Tout est recalculé depuis les tableaux déjà chargés par
      // fetchAdminData() (newsArticles, eventsAdmin, registrants, messages,
      // recensementList) — pas de nouvel appel réseau nécessaire.
      document.getElementById('stats-articles-publies').textContent =
        newsArticles.filter((a) => a.status === 'Publié').length;
      document.getElementById('stats-inscriptions-confirmees').textContent =
        registrants.filter((r) => r.status === 'Confirmé').length;
      document.getElementById('stats-recensement').textContent = recensementList.length;
      document.getElementById('stats-messages-a-traiter').textContent =
        messages.filter((m) => m.status === 'Non lu' || m.status === 'À traiter').length;

      const upcoming = eventsAdmin.filter((e) => e.tab === 'À venir').slice(0, 5);
      const upcomingWrapper = document.getElementById('stats-upcoming-events');
      upcomingWrapper.innerHTML = upcoming.length
        ? ''
        : '<div style="font-size:13.5px; color:#5a655f;">Aucun événement à venir.</div>';
      upcoming.forEach((ev) => {
        const item = document.createElement('div');
        item.style.cssText = 'display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; gap:10px;';
        item.innerHTML = `<span style="color:#1F2925;">${ev.title}</span><span style="font-weight:700; color:#176B4D; white-space:nowrap;">${ev.date}</span>`;
        upcomingWrapper.appendChild(item);
      });

      const pending = messages.filter((m) => m.status === 'Non lu' || m.status === 'À traiter').slice(0, 5);
      const pendingWrapper = document.getElementById('stats-recent-messages');
      pendingWrapper.innerHTML = pending.length
        ? ''
        : '<div style="font-size:13.5px; color:#5a655f;">Rien à traiter.</div>';
      pending.forEach((m) => {
        const item = document.createElement('div');
        item.style.cssText = 'display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; gap:10px;';
        item.innerHTML = `<span style="color:#1F2925;">${m.from_name} — ${m.subject}</span><span style="color:#9aa39c; white-space:nowrap;">${m.status}</span>`;
        pendingWrapper.appendChild(item);
      });
    }

    // MAIN DOM LISTENERS AND SELECTORS SAFELY WRAPPED
    document.addEventListener('DOMContentLoaded', async () => {
      // Nav structure init
      generateNav();

      // Câblage des vues partagées (upload, formulaires) — une seule fois.
      content.wire();

      // Load D1 data
      await fetchAdminData();
      
      // Open dashboard (ou l'onglet où on était avant un rechargement)
      let initialPage = 'dashboard';
      try {
        const saved = sessionStorage.getItem('admin-current-page');
        if (saved && document.getElementById(`view-${saved}`)) initialPage = saved;
      } catch {}
      goPage(initialPage);

      // Logout handler
      document.querySelectorAll('.logout-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          await fetch('/api/logout', { method: 'POST' });
          window.location.href = '/connexion';
        });
      });

      // Afficher/masquer un champ mot de passe (délégation).
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.toggle-password-visibility-btn');
        if (!btn) return;
        const input = document.getElementById(btn.dataset.target);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.setAttribute('aria-label', showing ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
      });

      // Mon profil — route commune à tous les rôles (api/superadmin/profile.js)
      document.getElementById('save-profile-btn')?.addEventListener('click', async () => {
        const nom = document.getElementById('profile-form-name').value.trim();
        const email = document.getElementById('profile-form-email').value.trim();
        const password = document.getElementById('profile-form-password').value;
        const passwordConfirm = document.getElementById('profile-form-password-confirm').value;

        if (password && password !== passwordConfirm) {
          alert('Les deux mots de passe ne correspondent pas.');
          return;
        }

        try {
          const res = await fetch('/api/superadmin/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nom, email, password: password || undefined })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          alert('Profil enregistré !');
          document.getElementById('profile-form-password').value = '';
          document.getElementById('profile-form-password-confirm').value = '';
          const sidebarName = document.getElementById('sidebar-user-name');
          if (sidebarName) sidebarName.textContent = nom;
        } catch (err) {
          alert(err.message);
        }
      });

      // Mobile Drawer actions
      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const mobileDrawer = document.getElementById('mobile-sidebar-drawer');

      if (openDrawerBtn && mobileDrawer) {
        openDrawerBtn.addEventListener('click', () => {
          mobileDrawer.classList.remove('hidden');
        });
      }
      if (closeDrawerBtn && mobileDrawer) {
        closeDrawerBtn.addEventListener('click', () => {
          mobileDrawer.classList.add('hidden');
        });
      }

      // Recensement Search listener
      const recSearchInput = document.getElementById('recensement-search-input');
      if (recSearchInput) {
        recSearchInput.addEventListener('input', (e) => {
          recensementSearch = e.target.value;
          renderRecensement();
        });
      }

      // Recensement Status tabs listeners
      document.querySelectorAll('.rec-tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.rec-tab-btn').forEach(b => {
            b.style.background = '#F8F4EC';
            b.style.color = '#1F2925';
          });
          e.target.style.background = '#176B4D';
          e.target.style.color = '#FFFFFF';
          state.recensementFilter = e.target.dataset.status;
          renderRecensement();
        });
      });

      // Recensement Export CSV
      const recExportBtn = document.getElementById('recensement-export-csv-btn');
      if (recExportBtn) {
        recExportBtn.addEventListener('click', () => {
          if (recensementList.length === 0) {
            alert("Aucune donnée à exporter.");
            return;
          }
          const headers = ["ID", "Prénom", "Nom", "Statut", "Téléphone", "E-mail", "Domaine", "Bénévole", "Date d'inscription"];
          const csvRows = [headers.join(";")];
          recensementList.forEach(r => {
            csvRows.push([
              r.id, r.first_name, r.last_name, r.status, r.phone, r.email,
              r.domaine || '',
              r.benevole ? 'Oui' : 'Non',
              r.created_at
            ].join(";"));
          });
          const blob = new Blob(["\uFEFF" + csvRows.join("\n")], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.setAttribute("href", url);
          link.setAttribute("download", `recensement_anb_${new Date().toISOString().split('T')[0]}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      }

      // Mobile FAB Trigger
      document.getElementById('mobile-fab-btn')?.addEventListener('click', () => {
        content.resetNewsForm();
        goPage('actualites-new');
      });

      // Raccourcis « Créer » présents dans les vues : le formulaire doit
      // toujours s'ouvrir vierge. (La navigation elle-même est prise en
      // charge par .nav-trigger-btn plus bas.)
      document.querySelectorAll('.btn-create-news').forEach((btn) => {
        btn.addEventListener('click', () => content.resetNewsForm());
      });
      document.querySelectorAll('.btn-create-event').forEach((btn) => {
        btn.addEventListener('click', () => content.resetEventForm());
      });

      // General nav triggers (buttons)
      document.querySelectorAll('.nav-trigger-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          goPage(btn.dataset.page);
        });
      });
    });
  </script>

</body>
</html>
