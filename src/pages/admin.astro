              <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13.5px; min-width:900px;">
                  <thead>
                    <tr style="background:#F8F4EC; border-bottom:1px solid rgba(31,41,37,0.06); color:#5a655f; font-weight:700;">
                      <th style="padding:14px 18px;">Nom Complet</th>
                      <th style="padding:14px 18px;">Statut</th>
                      <th style="padding:14px 18px;">Domaine</th>
                      <th style="padding:14px 18px;">Bénévole</th>
                      <th style="padding:14px 18px;">E-mail</th>
                      <th style="padding:14px 18px;">Tél.</th>
                      <th style="padding:14px 18px; text-align:right;">Actions</th>
