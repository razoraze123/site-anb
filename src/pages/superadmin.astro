      profil: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.4"></circle><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"></path></svg>`
    };

    // Remplis par loadOverview() depuis GET /api/superadmin/stats.
    let attentionItems = [];
    let govActivity = [];

    // Rempli par loadUsers() depuis GET /api/superadmin/users — plus de données figées.
    let users = [];

    const ROLE_LABELS = { admin: ['Admin', 'o'], super_admin: ['Super Admin', 'g'], editeur: ['Éditeur', 'n'] };
    const ROLE_PERMISSIONS = {
      admin: "Gestion des contenus, événements, médias, messages et demandes. Traitement des inscriptions.",
      super_admin: "Accès complet : utilisateurs et rôles, réglages globaux, exports, journal d'activité.",
      editeur: "Création d'articles, événements et ressources en brouillon uniquement."
    };
    const AVATAR_GRADIENTS = ['linear-gradient(150deg,#176B4D,#E97824)', 'linear-gradient(150deg,#1F2925,#176B4D)', 'linear-gradient(150deg,#E8D8BF,#176B4D)', 'linear-gradient(150deg,#E97824,#1F2925)', 'linear-gradient(150deg,#5a655f,#1F2925)'];

    function decorateUser(u, i) {
      const [roleLabel, roleT] = ROLE_LABELS[u.role] || [u.role, 'n'];
      return {
        id: u.id,
        name: u.nom,
        email: u.email,
        dbRole: u.role,
        dbStatut: u.statut,
        role: roleLabel,
        roleT,
        status: u.statut === 'actif' ? 'Actif' : 'Désactivé',
        statusT: u.statut === 'actif' ? 'g' : 'r',
        last: '—',
        avatarBg: AVATAR_GRADIENTS[i % AVATAR_GRADIENTS.length],
        permissions: ROLE_PERMISSIONS[u.role] || ''
      };
    }

    async function loadUsers() {
      const container = document.getElementById('users-list-container');
      container.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Chargement…</div>';
      try {
        const res = await fetch('/api/superadmin/users');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');
        users = data.users.map(decorateUser);
        state.userSelectedIdx = 0;
        renderUsers();
      } catch (err) {
        container.innerHTML = `<div style="padding:24px; font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }

    const permissionMatrix = [
      { label: 'Gestion des contenus (articles, événements, médias)', superadmin: '✓', admin: '✓', editeur: 'Brouillon' },
      { label: 'Traitement des inscriptions et adhésions', superadmin: '✓', admin: '✓', editeur: '—' },
      { label: 'Messages et demandes de contact', superadmin: '✓', admin: '✓', editeur: '—' },
      { label: 'Statistiques de fréquentation', superadmin: '✓', admin: 'Simples', editeur: '—' },
      { label: 'Gestion des utilisateurs et rôles', superadmin: '✓', admin: '—', editeur: '—' },
      { label: 'Réglages globaux du site', superadmin: '✓', admin: '—', editeur: '—' },
      { label: 'Exports de données de la plateforme', superadmin: '✓', admin: '—', editeur: '—' },
      { label: 'Sécurité et sauvegardes', superadmin: '✓', admin: '—', editeur: '—' }
    ];

    // Rempli par loadValidations() depuis GET /api/superadmin/validations
    // (actualités au statut 'En attente' — posé par la soumission éditeur,
    // Phase 2, pas encore branchée : cette file peut donc être vide pour
    // l'instant).
    let validationQueue = [];

    async function loadValidations() {
      const container = document.getElementById('validations-queue-list');
      container.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Chargement…</div>';
      try {
        const res = await fetch('/api/superadmin/validations');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');
        validationQueue = data.items.map(it => ({
          id: it.id,
          author: it.auteur_nom || 'Auteur inconnu',
          type: 'Article',
          date: formatJournalDate(it.created_at),
          title: it.title,
          status: it.status
        }));
        state.validationSelectedIdx = 0;
        renderValidations();
      } catch (err) {
        container.innerHTML = `<div style="padding:24px; font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }

    // Rempli par loadJournal() depuis GET /api/superadmin/journal.
    let journalLogs = [];

    const JOURNAL_ROLE_T = { Admin: 'o', 'Super Admin': 'g', 'Éditeur': 'n' };
    const MONTHS_FR = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];

    function firstNameFromEmail(email) {
      const local = (email || '').split('@')[0] || '';
      const first = local.split('.')[0] || local;
      return first ? first.charAt(0).toUpperCase() + first.slice(1) : 'Inconnu';
    }

    function formatJournalDate(sqlDate) {
      // "YYYY-MM-DD HH:MM:SS" (UTC, tel que stocké par D1) -> "12 juillet 2026, 14:32"
      if (!sqlDate) return '—';
      const [datePart, timePart] = sqlDate.split(' ');
      const [y, m, d] = (datePart || '').split('-').map(Number);
      const [h, min] = (timePart || '').split(':');
      if (!y || !m || !d) return sqlDate;
      return `${d} ${MONTHS_FR[m - 1]} ${y}, ${h}:${min}`;
    }

    async function loadJournal() {
      const container = document.getElementById('journal-list-container');
      container.innerHTML = '<div style="padding:24px; font-size:13.5px; color:#5a655f;">Chargement…</div>';
      try {
        const res = await fetch('/api/superadmin/journal');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');
        journalLogs = data.logs.map(l => ({
          date: formatJournalDate(l.created_at),
          user: firstNameFromEmail(l.utilisateur_email),
          role: l.role,
          roleT: JOURNAL_ROLE_T[l.role] || 'n',
          action: l.action,
          detail: l.details,
          ip: l.adresse_ip
        }));
        renderJournal();
      } catch (err) {
        container.innerHTML = `<div style="padding:24px; font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }

    const integrations = [
      { name: 'Google Maps', desc: 'Affiche la carte sur la page Contact', status: 'Connecté', tone: 'g', sync: "Aujourd'hui, 07:00", actionLabel: 'Configurer' },
      { name: 'Outil newsletter', desc: 'Envoi des actualités par e-mail', status: 'Connecté', tone: 'g', sync: 'Hier, 22:00', actionLabel: 'Configurer' },
      { name: 'Paiement / adhésion en ligne', desc: 'Paiement de la cotisation en ligne', status: 'Non connecté', tone: 'n', sync: '—', actionLabel: 'Connecter' },
      { name: 'Analytics', desc: 'Statistiques de fréquentation du site', status: 'Connecté', tone: 'g', sync: "Aujourd'hui, 06:00", actionLabel: 'Configurer' },
      { name: 'Réseaux sociaux', desc: 'Partage automatique sur Facebook et Instagram', status: 'Connecté', tone: 'g', sync: 'Il y a 3h', actionLabel: 'Configurer' },
      { name: 'Formulaires', desc: 'Réception des formulaires du site', status: 'Connecté', tone: 'g', sync: "Aujourd'hui, 09:00", actionLabel: 'Configurer' }
    ];

    const backupHistory = [
      { date: '12 juillet 2026, 03:00', status: 'Réussie', tone: 'g', size: '482 Mo' },
      { date: '11 juillet 2026, 03:00', status: 'Réussie', tone: 'g', size: '480 Mo' },
      { date: '10 juillet 2026, 03:00', status: 'Réussie', tone: 'g', size: '479 Mo' },
      { date: '09 juillet 2026, 03:00', status: 'Échouée', tone: 'r', size: '—' }
    ];

    const legalSections = [
      { title: 'Mentions légales', updated: '12 juillet 2026' },
      { title: 'Politique de confidentialité', updated: '12 juillet 2026' },
      { title: 'Gestion des cookies', updated: '5 mars 2026' },
      { title: 'Durées de conservation des données', updated: '5 mars 2026' },
      { title: 'Consentements des formulaires', updated: '5 mars 2026' }
    ];

    // Helper function for badges
    function getBadgeHtml(label, tone) {
      const map = {
        g: { bg: 'rgba(23,107,77,0.12)', color: '#176B4D' },
        o: { bg: 'rgba(233,120,36,0.16)', color: '#B75E12' },
        r: { bg: 'rgba(177,69,36,0.13)', color: '#B14524' },
        n: { bg: 'rgba(31,41,37,0.08)', color: '#5a655f' }
      };
      const c = map[tone] || map.n;
      return `<span style="background:${c.bg}; color:${c.color}; padding:4px 12px; border-radius:999px; font-size:12px; font-weight:700;">${label}</span>`;
    }

    document.addEventListener('DOMContentLoaded', () => {
      generateNav();
      goPage('overview');

      document.querySelectorAll('.logout-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          window.location.href = '/connexion';
        });
      });

      // Mobile Drawer actions
      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const mobileDrawer = document.getElementById('mobile-sidebar-drawer');

      openDrawerBtn.addEventListener('click', () => {
        mobileDrawer.classList.remove('hidden');
      });
      closeDrawerBtn.addEventListener('click', () => {
        mobileDrawer.classList.add('hidden');
      });
    });

    function goPage(pageKey) {
      state.page = pageKey;
      
      document.querySelectorAll('.sidebar-link').forEach(link => {
        if (link.dataset.page === pageKey) {
          link.classList.add('active-nav-btn');
        } else {
          link.classList.remove('active-nav-btn');
        }
      });

      const pageTitleMap = {
        overview: "Vue d'ensemble", users: 'Utilisateurs & rôles', contenus: 'Contenus & validations',
        donnees: 'Données & exports', journal: "Journal d'activité", reglages: 'Réglages du site',
        integrations: 'Intégrations', securite: 'Sécurité', sauvegardes: 'Sauvegardes',
        mentions: 'Mentions & RGPD', stats: 'Statistiques globales', profil: 'Mon profil'
      };

      document.getElementById('breadcrumb-page-label').textContent = pageTitleMap[pageKey] || '';
      document.getElementById('title-page-label').textContent = pageTitleMap[pageKey] || '';

      document.querySelectorAll('section[id^="view-"]').forEach(sec => {
        sec.classList.add('hidden');
      });
      
      const targetView = document.getElementById(`view-${pageKey}`);
      if (targetView) targetView.classList.remove('hidden');

      document.getElementById('mobile-sidebar-drawer').classList.add('hidden');

      renderPageDetails(pageKey);
    }

    function generateNav() {
      const desktopContainer = document.getElementById('desktop-sidebar-nav');
      const mobileContainer = document.getElementById('mobile-sidebar-nav');

      desktopContainer.innerHTML = '';
      mobileContainer.innerHTML = '';

      function createLink(item) {
        const link = document.createElement('a');
        link.className = 'sidebar-link';
        link.dataset.page = item.key;
        link.style.cursor = 'pointer';
        const svgContent = svgMap[item.key] || '';
        link.innerHTML = `${svgContent}<span>${item.label}</span>`;
        link.addEventListener('click', () => {
          goPage(item.key);
        });
        return link;
      }

      navigationItems.forEach(item => {
        if (item.type === 'header') {
          const header = document.createElement('div');
          header.style.cssText = 'font-size:11px; font-weight:700; color:#9aa39c; text-transform:uppercase; letter-spacing:0.05em; padding:16px 14px 6px;';
          header.textContent = item.label;
          desktopContainer.appendChild(header);
          mobileContainer.appendChild(header.cloneNode(true));
        } else if (item.type === 'separator') {
          const sep = document.createElement('div');
          sep.style.cssText = 'height:1px; background:rgba(31,41,37,0.07); margin:10px 6px;';
          desktopContainer.appendChild(sep);
          mobileContainer.appendChild(sep.cloneNode(true));
        } else {
          desktopContainer.appendChild(createLink(item));
          mobileContainer.appendChild(createLink(item));
        }
      });
    }

    function logActivity(user, role, action, detail) {
      const date = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const dateStr = `${date.getDate()} juillet 2026, ${pad(date.getHours())}:${pad(date.getMinutes())}`;
      
      journalLogs.unshift({
        date: dateStr,
        user,
        role,
        roleT: 'g',
        action,
        detail,
        ip: '82.1XX.XX.XX'
      });
    }

    function renderPageDetails(pageKey) {
      if (pageKey === 'overview') {
        loadOverview();
      } else if (pageKey === 'users') {
        loadUsers();
      } else if (pageKey === 'contenus') {
        loadValidations();
      } else if (pageKey === 'journal') {
        loadJournal();
      } else if (pageKey === 'integrations') {
        renderIntegrations();
      } else if (pageKey === 'securite') {
        renderSecurite();
      } else if (pageKey === 'sauvegardes') {
        renderSauvegardes();
      } else if (pageKey === 'mentions') {
        renderMentions();
      } else if (pageKey === 'stats') {
        loadStats();
      }
    }

    // 1. Overview
    async function loadOverview() {
      try {
        const res = await fetch('/api/superadmin/stats');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');

        document.getElementById('stat-membres').textContent = data.overview.membres;
        document.getElementById('stat-adhesions-mois').textContent = data.overview.adhesions_ce_mois;
        document.getElementById('stat-evenements').textContent = data.overview.evenements_a_venir;
        document.getElementById('stat-demandes').textContent = data.overview.demandes_a_traiter;
        document.getElementById('stat-admins').textContent = data.overview.admins_actifs;
        document.getElementById('stat-desactives').textContent = data.overview.comptes_desactives;

        attentionItems = data.attention.map(text => ({ text }));
        govActivity = data.recent_activity.map(l => ({
          text: `${firstNameFromEmail(l.utilisateur_email)} — ${l.action} : ${l.details}`,
          time: formatJournalDate(l.created_at)
        }));
        renderOverview();
      } catch (err) {
        document.getElementById('overview-attention-list').innerHTML = `<div style="font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }

    function renderOverview() {
      const attWrapper = document.getElementById('overview-attention-list');
      attWrapper.innerHTML = '';
      if (attentionItems.length === 0) {
        attWrapper.innerHTML = '<div style="font-size:13.5px; color:#5a655f;">Rien à signaler.</div>';
      }
      attentionItems.forEach(a => {
        const item = document.createElement('div');
        item.style.cssText = 'display:flex; align-items:center; gap:12px; padding:12px 14px; background:rgba(233,120,36,0.08); border-radius:12px;';
        item.innerHTML = `
          <span style="width:8px; height:8px; border-radius:50%; background:#E97824; flex-shrink:0;"></span>
          <span style="font-size:13.5px; color:#1F2925;">${a.text}</span>
        `;
        attWrapper.appendChild(item);
      });

      const actWrapper = document.getElementById('overview-activity-list');
      actWrapper.innerHTML = '';
      if (govActivity.length === 0) {
        actWrapper.innerHTML = '<div style="font-size:13.5px; color:#5a655f;">Aucune activité récente.</div>';
      }
      govActivity.forEach(a => {
        const item = document.createElement('div');
        item.style.cssText = 'display:flex; gap:12px; align-items:flex-start; font-size:14px; color:#3f4a45;';
        item.innerHTML = `
          <div style="width:8px; height:8px; border-radius:50%; background:#176B4D; margin-top:7px; flex-shrink:0;"></div>
          <div>${a.text}<span style="color:#9aa39c; font-size:12.5px; display:block; margin-top:2px;">${a.time}</span></div>
        `;
        actWrapper.appendChild(item);
      });
    }

    // 2. Users
    function renderUsers() {
      const container = document.getElementById('users-list-container');
      container.innerHTML = '';

      users.forEach((u, i) => {
        const isSelected = state.userSelectedIdx === i;
        const item = document.createElement('div');
        item.style.cssText = `display:flex; align-items:center; gap:14px; padding:14px 16px; border-bottom:1px solid rgba(31,41,37,0.06); cursor:pointer; flex-wrap:wrap; background:${isSelected ? '#F8F4EC' : 'transparent'}; border-left:3px solid ${isSelected ? '#176B4D' : 'transparent'};`;
        item.innerHTML = `
          <div style="width:36px; height:36px; border-radius:50%; background:${u.avatarBg}; flex-shrink:0;"></div>
          <div style="flex:1; min-width:160px;">
            <div style="font-size:14px; font-weight:700; color:#1F2925;">${u.name}</div>
            <div style="font-size:12.5px; color:#5a655f;">${u.email}</div>
          </div>
          ${getBadgeHtml(u.role, u.roleT)}
          ${getBadgeHtml(u.status, u.statusT)}
          <div style="font-size:12px; color:#9aa39c; min-width:120px;">Dernière con. : ${u.last}</div>
        `;
        item.addEventListener('click', () => {
          state.userSelectedIdx = i;
          renderUsers();
        });
        container.appendChild(item);
      });

      const detailBox = document.getElementById('user-detail-box');
      const selected = users[state.userSelectedIdx];

      if (!selected) {
        detailBox.innerHTML = '';
        return;
      }

      detailBox.innerHTML = `
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:18px;">
          <div style="width:48px; height:48px; border-radius:50%; background:${selected.avatarBg};"></div>
          <div>
            <div style="font-size:16px; font-weight:700; color:#1F2925;">${selected.name}</div>
            <div style="font-size:13px; color:#5a655f;">${selected.email}</div>
          </div>
        </div>
        <div style="display:flex; gap:8px; margin-bottom:18px;">
          ${getBadgeHtml(selected.role, selected.roleT)}
          ${getBadgeHtml(selected.status, selected.statusT)}
        </div>
        <div style="font-size:13px; color:#5a655f; margin-bottom:6px;">Dernière connexion : ${selected.last}</div>
        <div style="font-size:13px; font-weight:700; color:#1F2925; margin:16px 0 8px;">Permissions détaillées</div>
        <p style="font-size:13.5px; line-height:1.6; color:#3f4a45; margin:0 0 20px; background: rgba(31,41,37,0.02); padding: 10px; border-radius:8px;">${selected.permissions}</p>
        <div style="display:flex; flex-direction:column; gap:10px;">
          <button id="user-reset-btn" style="background:#F8F4EC; color:#1F2925; border:none; padding:11px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer;">Réinitialiser l'accès</button>
          <button id="user-toggle-btn" style="background:#F8F4EC; color:#1F2925; border:none; padding:11px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer;">${selected.status === 'Actif' ? 'Suspendre le compte' : 'Activer le compte'}</button>
        </div>
      `;

      document.getElementById('user-reset-btn').addEventListener('click', async () => {
        try {
          const res = await fetch('/api/superadmin/users', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: selected.id, resetPassword: true })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          alert(`Nouveau mot de passe temporaire pour ${selected.email} : ${data.tempPassword}\n(à communiquer manuellement — aucun e-mail n'est envoyé)`);
        } catch (err) {
          alert(err.message);
        }
      });
      document.getElementById('user-toggle-btn').addEventListener('click', async () => {
        const newStatut = selected.dbStatut === 'actif' ? 'desactive' : 'actif';
        try {
          const res = await fetch('/api/superadmin/users', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: selected.id, statut: newStatut })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          state.userSelectedIdx = users.findIndex(u => u.id === selected.id);
          await loadUsers();
        } catch (err) {
          alert(err.message);
        }
      });

      const matrixWrapper = document.getElementById('permission-matrix-rows');
      matrixWrapper.innerHTML = '';
      permissionMatrix.forEach(row => {
        const tr = document.createElement('div');
        tr.style.cssText = 'display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr; gap:8px; padding:10px 0; border-bottom:1px solid rgba(31,41,37,0.05); align-items:center;';
        tr.innerHTML = `
          <div style="font-size:13px; color:#1F2925;">${row.label}</div>
          <div style="text-align:center; font-size:15px; font-weight:600; color:#176B4D;">${row.superadmin}</div>
          <div style="text-align:center; font-size:15px; font-weight:600; color:#E97824;">${row.admin}</div>
          <div style="text-align:center; font-size:15px; font-weight:600; color:#5a655f;">${row.editeur}</div>
        `;
        matrixWrapper.appendChild(tr);
      });
    }

    const toggleInviteBtn = document.getElementById('toggle-invite-btn');
    const inviteBox = document.getElementById('invite-user-box');
    toggleInviteBtn.addEventListener('click', () => {
      state.inviteOpen = !state.inviteOpen;
      if (state.inviteOpen) {
        inviteBox.classList.remove('hidden');
      } else {
        inviteBox.classList.add('hidden');
      }
      document.getElementById('invite-success-alert').classList.add('hidden');
    });

    document.getElementById('invite-user-submit-btn').addEventListener('click', async () => {
      const name = document.getElementById('invite-form-name').value.trim();
      const email = document.getElementById('invite-form-email').value.trim();
      const roleSelectValue = document.getElementById('invite-form-role').value;
      const dbRoleMap = { Admin: 'admin', 'Super Admin': 'super_admin', 'Éditeur / Bénévole': 'editeur' };

      if (!name || !email) {
        alert('Veuillez remplir le nom et le mail.');
        return;
      }

      try {
        const res = await fetch('/api/superadmin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nom: name, email, role: dbRoleMap[roleSelectValue] })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur.');

        const successAlert = document.getElementById('invite-success-alert');
        successAlert.textContent = `✓ Compte créé pour ${email}. Mot de passe temporaire : ${data.tempPassword} (à communiquer manuellement, aucun e-mail n'est envoyé).`;
        successAlert.classList.remove('hidden');

        document.getElementById('invite-form-name').value = '';
        document.getElementById('invite-form-email').value = '';
        await loadUsers();
      } catch (err) {
        alert(err.message);
      }
    });

    // 3. Validations
    function renderValidations() {
      const listWrapper = document.getElementById('validations-queue-list');
      listWrapper.innerHTML = '';

      validationQueue.forEach((c, i) => {
        const isSelected = state.validationSelectedIdx === i;
        const item = document.createElement('div');
        item.style.cssText = `padding:16px; border-bottom:1px solid rgba(31,41,37,0.06); cursor:pointer; background:${isSelected ? '#F8F4EC' : 'transparent'}; border-left:3px solid ${isSelected ? '#176B4D' : 'transparent'};`;
        item.innerHTML = `
          <div style="display:flex; justify-content:space-between; gap:8px;">
            <span style="background:rgba(23,107,77,0.08); color:#176B4D; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700;">${c.type}</span>
            <span style="font-size:12px; color:#9aa39c;">${c.date}</span>
          </div>
          <div style="font-size:14px; font-weight:700; color:#1F2925; margin-top:8px;">${c.title}</div>
          <div style="font-size:12.5px; color:#5a655f; margin-top:2px;">Par ${c.author} · ${c.status}</div>
        `;
        item.addEventListener('click', () => {
          state.validationSelectedIdx = i;
          renderValidations();
        });
        listWrapper.appendChild(item);
      });

      const detailBox = document.getElementById('validation-detail-box');
      const selected = validationQueue[state.validationSelectedIdx] || validationQueue[0];

      if (!selected) {
        detailBox.innerHTML = '';
        return;
      }

      detailBox.innerHTML = `
        <h3 style="font-size:16px; font-weight:700; color:#1F2925; margin:0 0 6px;">${selected.title}</h3>
        <div style="font-size:13px; color:#5a655f; margin-bottom:16px;">Par ${selected.author} · ${selected.date}</div>
        <div style="aspect-ratio:16/9; border-radius:14px; background:linear-gradient(150deg,#E8D8BF,#176B4D); margin-bottom:18px;"></div>
        <div style="font-size:13px; font-weight:700; color:#1F2925; margin-bottom:8px;">Commentaire pour l'auteur</div>
        <textarea id="validation-comment-text" rows="2" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:13.5px; resize:vertical; margin-bottom:16px;" placeholder="Optionnel..."></textarea>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
          <button id="validation-approve-btn" style="background:#176B4D; color:#FFFFFF; border:none; padding:11px 20px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer;">Approuver et publier</button>
          <button id="validation-return-btn" style="background:#F8F4EC; color:#1F2925; border:none; padding:11px 20px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer;">Renvoyer avec commentaire</button>
        </div>
      `;

      document.getElementById('validation-approve-btn').addEventListener('click', async () => {
        try {
          const res = await fetch('/api/superadmin/validations', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: selected.id, action: 'approve' })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          alert(`Le contenu "${selected.title}" a été approuvé et publié !`);
          await loadValidations();
        } catch (err) {
          alert(err.message);
        }
      });

      document.getElementById('validation-return-btn').addEventListener('click', async () => {
        const comment = document.getElementById('validation-comment-text').value.trim() || 'Des ajustements sont requis.';
        try {
          const res = await fetch('/api/superadmin/validations', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: selected.id, action: 'return', comment })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Erreur.');
          alert(`Le contenu a été renvoyé avec votre commentaire.`);
          await loadValidations();
        } catch (err) {
          alert(err.message);
        }
      });
    }

    const generateExportBtn = document.getElementById('generate-export-btn');
    const exportConfirmBox = document.getElementById('export-confirm-box');
    const exportSuccessAlert = document.getElementById('export-success-alert');

    generateExportBtn.addEventListener('click', () => {
      const reason = document.getElementById('export-reason').value.trim();
      if (!reason) {
        alert('Veuillez entrer une raison de sécurité pour justifier cet export.');
        return;
      }
      exportConfirmBox.classList.remove('hidden');
      exportSuccessAlert.classList.add('hidden');
    });

    document.getElementById('confirm-export-action').addEventListener('click', async () => {
      const reason = document.getElementById('export-reason').value.trim();
      const period = document.getElementById('export-period').value;
      const include = ['adhesions', 'inscriptions', 'messages'].filter(
        (k) => document.getElementById(`export-check-${k}`).checked
      );

      if (include.length === 0) {
        alert('Sélectionnez au moins une source de données.');
        return;
      }

      try {
        const res = await fetch('/api/superadmin/export', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ include, period, reason })
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Erreur lors de la génération de l\'export.');
        }
        const csv = await res.text();
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `export-anb-${Date.now()}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);

        exportConfirmBox.classList.add('hidden');
        exportSuccessAlert.classList.remove('hidden');
        setTimeout(() => {
          exportSuccessAlert.classList.add('hidden');
          document.getElementById('export-reason').value = '';
        }, 3000);
      } catch (err) {
        alert(err.message);
      }
    });

    document.getElementById('cancel-export-action').addEventListener('click', () => {
      exportConfirmBox.classList.add('hidden');
    });

    // 5. Journal
    function renderJournal() {
      const tabsWrapper = document.querySelector('.journal-tab-container');
      tabsWrapper.innerHTML = '';
      const filters = ['Tous', ...new Set(journalLogs.map(j => j.user))];

      filters.forEach(f => {
        const btn = document.createElement('button');
        btn.style.cssText = `border:2px solid #176B4D; padding:9px 18px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer;`;
        if (state.journalUserFilter === f) {
          btn.style.background = '#176B4D';
          btn.style.color = '#FFFFFF';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = '#176B4D';
        }
        btn.textContent = f;
        btn.addEventListener('click', () => {
          state.journalUserFilter = f;
          renderJournal();
        });
        tabsWrapper.appendChild(btn);
      });

      const container = document.getElementById('journal-list-container');
      container.innerHTML = '';

      const filtered = state.journalUserFilter === 'Tous' ? journalLogs : journalLogs.filter(j => j.user === state.journalUserFilter);

      filtered.forEach(j => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; gap:16px; padding:16px; border-bottom:1px solid rgba(31,41,37,0.06); flex-wrap:wrap; font-size: 13.5px;';
        row.innerHTML = `
          <div style="min-width:170px; color:#5a655f;">${j.date}</div>
          <div style="min-width:110px; font-weight:700; color:#1F2925;">${j.user}</div>
          <div style="min-width:120px;">${getBadgeHtml(j.role, j.roleT)}</div>
          <div style="flex:1; min-width:220px; color:#1F2925;"><strong>${j.action}</strong> — <span style="color:#5a655f;">${j.detail}</span></div>
          <div style="font-size:11.5px; color:#9aa39c;">IP ${j.ip}</div>
        `;
        container.appendChild(row);
      });
    }

    // 6. Intégrations
    function renderIntegrations() {
      const container = document.getElementById('integrations-list-container');
      container.innerHTML = '';

      integrations.forEach(i => {
        const card = document.createElement('div');
        card.style.cssText = 'background:#FFFFFF; border-radius:18px; padding:22px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display: flex; flex-direction: column; justify-content: space-between;';
        card.innerHTML = `
          <div>
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; gap: 8px;">
              <h3 style="font-size:15px; font-weight:700; color:#1F2925; margin:0;">${i.name}</h3>
              ${getBadgeHtml(i.status, i.tone)}
            </div>
            <p style="font-size:13px; color:#5a655f; line-height:1.5; margin:0 0 12px;">${i.desc}</p>
            <div style="font-size:11.5px; color:#9aa39c; margin-bottom:14px;">Synchro : ${i.sync}</div>
          </div>
          <button style="background:#F8F4EC; color:#1F2925; border:none; padding:9px 18px; border-radius:999px; font-weight:700; font-size:12.5px; cursor:pointer;" onclick="alert('Configuration integration : ${i.name}')">${i.actionLabel}</button>
        `;
        container.appendChild(card);
      });
    }

    // 7. Sécurité
    function renderSecurite() {
      const toggleBtn = document.getElementById('twofa-toggle-btn');
      const indicator = document.getElementById('twofa-toggle-indicator');
      const statusLabel = document.getElementById('twofa-status-label');

      const update2FA = () => {
        if (state.twoFA) {
          toggleBtn.style.background = '#176B4D';
          indicator.style.left = '23px';
          statusLabel.textContent = 'Activée pour votre compte.';
        } else {
          toggleBtn.style.background = '#d8d0c0';
          indicator.style.left = '3px';
          statusLabel.textContent = 'Désactivée — activation recommandée.';
        }
      };

      toggleBtn.replaceWith(toggleBtn.cloneNode(true));
      document.getElementById('twofa-toggle-btn').addEventListener('click', () => {
        state.twoFA = !state.twoFA;
        update2FA();
        logActivity('Nasser', 'Super Admin', 'Sécurité 2FA modifiée', state.twoFA ? '2FA Activée' : '2FA Désactivée');
      });

      update2FA();

      const list = document.getElementById('active-sessions-list');
      list.innerHTML = '';
      const sessions = [
        { device: 'Chrome — Windows (Garba)', location: 'Bordeaux, France', time: 'Session active' },
        { device: 'Safari — iPhone', location: 'Bordeaux, France', time: 'Il y a 1 heure' },
        { device: 'Chrome — Windows (Test)', location: 'Paris, France', time: 'Il y a 2 jours' }
      ];

      sessions.forEach(s => {
        const item = document.createElement('div');
        item.style.cssText = 'display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; flex-wrap:wrap; gap:8px;';
        item.innerHTML = `
          <span style="color:#1F2925; font-weight:600;">${s.device}</span>
          <span style="color:#5a655f;">${s.location}</span>
          <span style="color:#9aa39c;">${s.time}</span>
        `;
        list.appendChild(item);
      });

      document.getElementById('disconnect-all-btn').onclick = () => {
        alert('Toutes les autres sessions ont été déconnectées.');
        logActivity('Nasser', 'Super Admin', 'Déconnexion sessions actives', 'Toutes sessions tierces révoquées');
      };
    }

    // 8. Sauvegardes
    function renderSauvegardes() {
      const historyList = document.getElementById('backup-history-list');
      historyList.innerHTML = '';

      backupHistory.forEach(b => {
        const row = document.createElement('div');
        row.style.cssText = 'display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; flex-wrap:wrap; gap:8px;';
        row.innerHTML = `
          <span style="color:#1F2925;">${b.date}</span>
          ${getBadgeHtml(b.status, b.tone)}
          <span style="color:#9aa39c;">${b.size}</span>
        `;
        historyList.appendChild(row);
      });
    }

    const runBackupBtn = document.getElementById('run-backup-btn');
    const backupAlert = document.getElementById('backup-running-alert');
    runBackupBtn.addEventListener('click', () => {
      backupAlert.classList.remove('hidden');
      const date = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const dateStr = `${date.getDate()} juillet 2026, ${pad(date.getHours())}:${pad(date.getMinutes())}`;
      
      backupHistory.unshift({
        date: dateStr,
        status: 'Réussie',
        tone: 'g',
        size: '483 Mo'
      });

      logActivity('Nasser', 'Super Admin', 'Lancement de sauvegarde', 'Sauvegarde manuelle du système');

      setTimeout(() => {
        backupAlert.classList.add('hidden');
        renderSauvegardes();
      }, 1500);
    });

    const openRestoreBtn = document.getElementById('open-restore-btn');
    const restoreBox = document.getElementById('restore-confirm-box');

    openRestoreBtn.addEventListener('click', () => {
      restoreBox.classList.remove('hidden');
    });
    document.getElementById('cancel-restore-action').addEventListener('click', () => {
      restoreBox.classList.add('hidden');
    });
    document.getElementById('confirm-restore-action').addEventListener('click', () => {
      restoreBox.classList.add('hidden');
      alert('Restauration système complétée.');
      logActivity('Nasser', 'Super Admin', 'Restauration système', 'Restauration effectuée avec succès');
      renderSauvegardes();
    });

    // 9. Mentions
    function renderMentions() {
      const container = document.getElementById('legal-sections-container');
      container.innerHTML = '';

      legalSections.forEach(ls => {
        const item = document.createElement('div');
        item.style.cssText = 'background:#FFFFFF; border-radius:18px; padding:22px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display: flex; justify-content: space-between; align-items: center; gap: 14px;';
        item.innerHTML = `
          <div>
            <h3 style="font-size:15px; font-weight:700; color:#1F2925; margin:0 0 6px;">${ls.title}</h3>
            <div style="font-size:12.5px; color:#9aa39c;">Dernière modification : ${ls.updated}</div>
          </div>
          <button style="background:#F8F4EC; color:#1F2925; border:none; padding:8px 16px; border-radius:999px; font-weight:700; font-size:12.5px; cursor:pointer;" onclick="alert('Modifier : ${ls.title}')">Modifier</button>
        `;
        container.appendChild(item);
      });
    }

    // 10. Statistiques
    const STATS_PERIODS = [
      { label: '7 jours', days: '7' },
      { label: '30 jours', days: '30' },
      { label: '3 mois', days: '90' },
      { label: '1 an', days: '365' }
    ];

    function renderStatsPeriodButtons() {
      const periodsWrapper = document.querySelector('.stats-period-container');
      periodsWrapper.innerHTML = '';
      STATS_PERIODS.forEach(p => {
        const btn = document.createElement('button');
        btn.style.cssText = `border:2px solid #176B4D; padding:8px 16px; border-radius:999px; font-weight:700; font-size:13px; cursor:pointer;`;
        if (state.statsPeriod === p.label) {
          btn.style.background = '#176B4D';
          btn.style.color = '#FFFFFF';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = '#176B4D';
        }
        btn.textContent = p.label;
        btn.addEventListener('click', () => {
          state.statsPeriod = p.label;
          loadStats();
        });
        periodsWrapper.appendChild(btn);
      });
    }

    async function loadStats() {
      renderStatsPeriodButtons();
      const periodDef = STATS_PERIODS.find(p => p.label === state.statsPeriod) || STATS_PERIODS[1];
      try {
        const res = await fetch(`/api/superadmin/stats?period=${periodDef.days}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Erreur de chargement.');

        document.getElementById('stat-period-inscriptions').textContent = data.period_stats.inscriptions;
        document.getElementById('stat-period-adhesions').textContent = data.period_stats.adhesions;
        document.getElementById('stat-period-membres').textContent = data.overview.membres;
        document.getElementById('stat-period-evenements').textContent = data.overview.evenements_a_venir;

        const eventsList = document.getElementById('top-pages-list');
        eventsList.innerHTML = '';
        if (data.upcoming_events.length === 0) {
          eventsList.innerHTML = '<div style="font-size:13.5px; color:#5a655f;">Aucun événement à venir.</div>';
        }
        data.upcoming_events.forEach(ev => {
          const item = document.createElement('div');
          item.style.cssText = 'display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; gap:10px;';
          item.innerHTML = `<span style="color:#1F2925;">${ev.title}</span><span style="font-weight:700; color:#176B4D; white-space:nowrap;">${ev.date}</span>`;
          eventsList.appendChild(item);
        });

        const articlesList = document.getElementById('top-articles-list');
        articlesList.innerHTML = '';
        if (data.latest_articles.length === 0) {
          articlesList.innerHTML = '<div style="font-size:13.5px; color:#5a655f;">Aucun article.</div>';
        }
        data.latest_articles.forEach(a => {
          const item = document.createElement('div');
          item.style.cssText = 'display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid rgba(31,41,37,0.06); font-size:13.5px; gap:10px;';
          item.innerHTML = `<span style="color:#1F2925;">${a.title}</span>${getBadgeHtml(a.status, a.status === 'Publié' ? 'g' : 'n')}`;
          articlesList.appendChild(item);
        });
      } catch (err) {
        document.getElementById('top-pages-list').innerHTML = `<div style="font-size:13.5px; color:#B14524;">${err.message}</div>`;
      }
    }
  </script>

</body>
</html>
