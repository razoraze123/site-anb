            <svg width="16" height="16" viewBox="0 0 24 24" fill="#F8F4EC"><path d="M16.5 3c.4 2.2 2 3.9 4.2 4.2v3.1c-1.5 0-2.9-.4-4.2-1.2v6.6c0 3.5-2.8 6.3-6.3 6.3S4 19.2 4 15.7s2.8-6.3 6.3-6.3c.4 0 .8 0 1.1.1v3.2c-.3-.1-.7-.2-1.1-.2-1.7 0-3.1 1.4-3.1 3.1s1.4 3.1 3.1 3.1 3.2-1.3 3.2-3V3h3z"></path></svg>
