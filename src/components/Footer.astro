      </div>
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:16px; justify-content:space-between; padding-top:26px;">
      <div style="font-size:13px; color:rgba(248,244,236,0.5);">© {year} ANB — Association des Nigériens à Bordeaux</div>
      <div style="display:flex; gap:20px; flex-wrap:wrap;">
        <a href="/mentions-legales" style="font-size:13px; color:rgba(248,244,236,0.5); cursor:pointer;">Mentions légales</a>
        <a href="/cgu" style="font-size:13px; color:rgba(248,244,236,0.5); cursor:pointer;">CGU</a>
        <a href="/confidentialite" style="font-size:13px; color:rgba(248,244,236,0.5); cursor:pointer;">Politique de confidentialité</a>
        <a href="/connexion" style="font-size:13px; color:rgba(248,244,236,0.5); cursor:pointer;">Espace ANB</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Reflète les réglages "Identité" édités depuis le Super Admin
  // (src/pages/api/settings.js -> site_settings) sans attendre un
  // redéploiement. Best-effort : en cas d'échec, les valeurs en dur
  // ci-dessus restent affichées.
  fetch('/api/settings')
    .then((res) => res.json())
    .then(({ settings }) => {
      const nom = document.getElementById('footer-nom');
      const slogan = document.getElementById('footer-slogan');
      const email = document.getElementById('footer-email');
      const phone = document.getElementById('footer-phone');
      const adresse = document.getElementById('footer-adresse');
      if (nom && settings.identite_nom) nom.textContent = settings.identite_nom;
      if (slogan && settings.identite_slogan) slogan.textContent = settings.identite_slogan;
      if (email && settings.identite_email) email.textContent = settings.identite_email;
      if (phone && settings.identite_telephone) phone.textContent = settings.identite_telephone;
      // Pas de repli fictif : tant qu'aucune adresse réelle n'est
      // renseignée, "Bordeaux Métropole" reste affiché tel quel.
      if (adresse && settings.identite_adresse) adresse.textContent = settings.identite_adresse;
    })
    .catch(() => {});
</script>
