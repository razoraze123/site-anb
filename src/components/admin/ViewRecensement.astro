---
// Vue Recensement — identique à /admin, logique dans lib/adminContent.js
// (renderRecensement(), câblage recherche/onglets/export dans wireRecensement(),
// appelée par content.wire()). Markup repris tel quel de l'ancien
// src/pages/admin.astro (section #view-recensement).
---
<section id="view-recensement" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
      <div>
        <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0 0 4px;">Recensement</h1>
        <div style="font-size:13px; color:#5a655f;">
          <span id="rec-count-label" style="font-weight:700; color:#176B4D;">0</span> membres recensés
          · <span id="rec-benevole-label" style="font-weight:700; color:#E97824;">0</span> bénévoles potentiels
        </div>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/recensement" target="_blank" style="background:#F8F4EC; color:#1F2925; border:none; padding:11px 18px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer; text-decoration:none; display:flex; align-items:center; gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
          Voir le formulaire
        </a>
        <button id="recensement-export-csv-btn" style="background:#176B4D; color:#FFFFFF; border:none; padding:11px 18px; border-radius:999px; font-weight:700; font-size:13.5px; cursor:pointer; display:flex; align-items:center; gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Exporter CSV
        </button>
      </div>
    </div>

    <!-- Filters & Search -->
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:16px; background:#FFFFFF; padding:14px 16px; border-radius:18px; box-shadow:0 8px 24px rgba(31,41,37,0.03);">
      <div style="display:flex; gap:6px; flex-wrap:wrap; flex:1 1 auto; min-width:0;" id="recensement-tabs">
        <!-- Généré par renderRecensementTabs() (lib/adminContent.js) à partir des statuts présents -->
      </div>
      <div style="position:relative; width:100%; max-width:280px;">
        <input id="recensement-search-input" autocomplete="off" placeholder="Rechercher…" style="width:100%; padding:9px 14px 9px 34px; border-radius:10px; border:1.5px solid #e3dccb; font-size:13px; box-sizing:border-box;" />
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5a655f" stroke-width="2" style="position:absolute; left:11px; top:50%; transform:translateY(-50%);"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
      </div>
    </div>

    <!-- Table -->
    <div style="background:#FFFFFF; border-radius:20px; box-shadow:0 8px 24px rgba(31,41,37,0.05); overflow:hidden;">
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13.5px; min-width:1100px;">
          <thead>
            <!-- En-têtes triables : clic = tri croissant, 2e clic = décroissant (flèche et aria-sort mises à jour par renderRecensement()) -->
            <tr id="recensement-thead" style="background:#F8F4EC; border-bottom:1px solid rgba(31,41,37,0.06); color:#5a655f; font-weight:700;">
              <th data-sort="nom" style="padding:0;"><button type="button" class="rec-sort-btn">Nom <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="prenom" style="padding:0;"><button type="button" class="rec-sort-btn">Prénom <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="status" style="padding:0;"><button type="button" class="rec-sort-btn">Statut <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="domaine" style="padding:0;"><button type="button" class="rec-sort-btn">Domaine <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="benevole" style="padding:0;"><button type="button" class="rec-sort-btn">Bénévole <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="email" style="padding:0;"><button type="button" class="rec-sort-btn">E-mail <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="phone" style="padding:0;"><button type="button" class="rec-sort-btn">Tél. <span class="rec-sort-arrow"></span></button></th>
              <th data-sort="created_at" style="padding:0;"><button type="button" class="rec-sort-btn">Adhésion <span class="rec-sort-arrow"></span></button></th>
              <th style="padding:14px 18px; text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody id="recensement-table-body">
            <!-- Dynamic -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <style>
    .rec-sort-btn {
      display: flex; align-items: center; gap: 6px; width: 100%;
      padding: 14px 18px; background: none; border: none; cursor: pointer;
      font: inherit; color: inherit; text-align: left; white-space: nowrap;
      transition: color 0.15s;
    }
    .rec-sort-btn:hover { color: #1F2925; }
    .rec-sort-arrow { font-size: 11px; color: #176B4D; min-width: 10px; }
    th[aria-sort] .rec-sort-btn { color: #1F2925; }
  </style>
</section>
