---
// Vues « Événements » (liste) et « Créer/Modifier un événement » (formulaire).
// Markup partagé entre /admin et /superadmin — la logique vit dans
// src/lib/adminContent.js, commune aux deux espaces.
---

<section id="view-evenements" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Événements</h1>
      <button class="btn-create-event nav-trigger-btn" data-page="evenements-new" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Créer un événement</button>
    </div>

    <div style="background:#176B4D; border-radius:22px; overflow:hidden; display:flex; flex-wrap:wrap;">
      <div id="promo-event-cover" style="flex:1 1 260px; min-width:220px; aspect-ratio:16/10; background:linear-gradient(150deg,#E97824,#1F2925);"></div>
      <div style="flex:2 1 320px; min-width:240px; padding:26px; color:#FFFFFF;">
        <div style="display:inline-block; background:rgba(233,120,36,0.25); color:#FFD9B0; font-size:11.5px; font-weight:700; padding:5px 12px; border-radius:999px; margin-bottom:12px;">Mis en avant</div>
        <h3 style="font-size:19px; font-weight:700; margin:0 0 8px;" id="promo-event-title">—</h3>
        <div style="font-size:13.5px; opacity:0.85;" id="promo-event-details">—</div>
      </div>
    </div>

    <div style="display:flex; gap:8px; flex-wrap:wrap;" class="events-tab-container">
      <!-- onglets générés dynamiquement -->
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px;" id="events-list-container">
      <!-- cartes générées dynamiquement -->
    </div>
  </div>
</section>

<section id="view-evenements-new" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px; max-width:820px;">
    <div style="display:flex; align-items:center; gap:14px;">
      <button class="nav-trigger-btn" data-page="evenements" style="width:36px; height:36px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.1); cursor:pointer; display: flex; align-items: center; justify-content: center;">←</button>
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Créer un événement</h1>
    </div>
    <div style="background:#FFFFFF; border-radius:20px; padding:28px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:18px;">
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Titre de l'événement</label>
        <input id="event-form-title" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Ex : Journée culturelle nigérienne" />
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:8px;">Image de couverture</label>
        <div id="event-upload-zone" style="border:2px dashed #d8cfb8; border-radius:14px; padding:40px 30px; text-align:center; color:#9aa39c; font-size:13.5px; cursor:pointer; background:#FFFFFF; position:relative; overflow:hidden; transition:all 0.15s ease; display:flex; align-items:center; justify-content:center; min-height:140px;">
          <span id="event-upload-placeholder" style="z-index:10;">Glissez-déposez une image ici, ou cliquez pour parcourir</span>
        </div>
        <input type="file" id="event-image-input" accept="image/*" style="display:none;" />
        <input type="hidden" id="event-form-image-url" />
      </div>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <div style="flex:1; min-width:180px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Catégorie</label>
          <select id="event-form-category" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;">
            <option>Culture</option>
            <option>Solidarité</option>
            <option>Sport</option>
            <option>Rencontre</option>
            <option>Formation</option>
          </select>
        </div>
        <div style="flex:1; min-width:180px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Date et heure</label>
          <input id="event-form-date" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="20/09/2026 — 11h00" />
        </div>
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Lieu / adresse</label>
        <input id="event-form-place" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Parc Bordelais, Bordeaux" />
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Description</label>
        <textarea id="event-form-desc" rows="4" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px; resize:vertical;" placeholder="Détails de l'événement"></textarea>
      </div>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <div style="flex:1; min-width:160px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nombre de places</label>
          <input id="event-form-places" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" value="120" />
        </div>
        <div style="flex:1; min-width:160px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Date limite d'inscription</label>
          <input style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="15/09/2026" />
        </div>
      </div>
      <div style="display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; border-top:1px solid rgba(31,41,37,0.07); padding-top:20px;">
        <button type="button" class="nav-trigger-btn" data-page="evenements" style="background:#F8F4EC; color:#1F2925; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Annuler</button>
        <button id="publish-event-submit-btn" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 26px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Publier l'événement</button>
      </div>
      <div id="event-publish-success-alert" class="hidden" style="background:rgba(23,107,77,0.08); color:#176B4D; padding:14px 18px; border-radius:12px; font-size:13.5px; font-weight:700;">✓ Événement enregistré avec succès.</div>
    </div>
  </div>
</section>
