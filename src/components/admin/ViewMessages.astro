---
// Vue « Messages » (liste + détail).
// Markup partagé entre /admin et /superadmin — la logique vit dans
// src/lib/adminContent.js, commune aux deux espaces.
---

<section id="view-messages" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Messages</h1>
    <div style="display:flex; gap:8px; flex-wrap:wrap;" class="messages-tab-container">
      <!-- onglets générés dynamiquement -->
    </div>
    <div style="display:grid; grid-template-columns:1fr 1.3fr; gap:20px; align-items:start; flex-wrap:wrap;">
      <div style="background:#FFFFFF; border-radius:20px; padding:8px; box-shadow:0 8px 24px rgba(31,41,37,0.05); min-width:0;" id="messages-list-container">
        <!-- liste générée dynamiquement -->
      </div>
      <div style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05); min-width:0;" id="message-detail-box">
        <!-- détail généré dynamiquement -->
      </div>
    </div>
  </div>
</section>
