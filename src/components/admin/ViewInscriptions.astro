---
// Vue « Inscriptions » : markup partagé entre /admin et /superadmin — la
// logique vit dans src/lib/adminContent.js, comme les vues Actualités,
// Événements et Messages.
---

<section id="view-inscriptions" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Inscriptions</h1>
    <div style="background:#FFFFFF; border-radius:20px; padding:24px; box-shadow:0 8px 24px rgba(31,41,37,0.05);">
      <select id="registrants-event-select" style="padding:11px 16px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14px; font-weight:700; color:#1F2925; margin-bottom:18px; background:transparent; width:100%; max-width:480px;">
        <!-- dynamic events list -->
      </select>
      <div style="display:flex; gap:24px; flex-wrap:wrap; margin-bottom:14px;">
        <div><span style="font-size:22px; font-weight:800; color:#176B4D;" id="event-reg-count">0</span> <span style="font-size:13px; color:#5a655f;">inscrits</span></div>
        <div><span style="font-size:22px; font-weight:800; color:#E97824;" id="event-remaining-places">0</span> <span style="font-size:13px; color:#5a655f;">places restantes</span></div>
      </div>
    </div>

    <div style="background:#FFFFFF; border-radius:20px; padding:8px; box-shadow:0 8px 24px rgba(31,41,37,0.05);" id="registrants-list-container">
      <!-- list -->
    </div>
  </div>
</section>
