---
// Vue « Galerie » (liste) et « Ajouter/Modifier un média » (formulaire).
// Markup partagé entre /admin et /superadmin — la logique vit dans
// src/lib/adminContent.js, même principe que Actualités/Événements.
// media_galerie est la source de vérité (remplace demo-data.ts
// fullGallery/homeGallery, voir /galerie et la home).
---

<section id="view-galerie" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Galerie</h1>
      <button class="btn-create-galerie nav-trigger-btn" data-page="galerie-new" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Ajouter un média</button>
    </div>
    <div id="galerie-list-container" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:18px;">
      <!-- liste générée dynamiquement -->
    </div>
  </div>
</section>

<section id="view-galerie-new" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px; max-width:640px;">
    <div style="display:flex; align-items:center; gap:14px;">
      <button class="nav-trigger-btn" data-page="galerie" style="width:36px; height:36px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.1); cursor:pointer; display: flex; align-items: center; justify-content: center;">←</button>
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Ajouter un média</h1>
    </div>
    <div style="background:#FFFFFF; border-radius:20px; padding:28px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:18px;">
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:8px;">Fichier</label>
        <div id="galerie-upload-zone" style="border:2px dashed #d8cfb8; border-radius:14px; padding:40px 30px; text-align:center; color:#9aa39c; font-size:13.5px; cursor:pointer; background:#FFFFFF; position:relative; overflow:hidden; transition:all 0.15s ease; display:flex; align-items:center; justify-content:center; min-height:140px;">
          <span id="galerie-upload-placeholder" style="z-index:10;">Glissez-déposez une image ou une vidéo ici, ou cliquez pour parcourir</span>
        </div>
        <input type="file" id="galerie-image-input" accept="image/*,video/*" style="display:none;" />
        <input type="hidden" id="galerie-form-image-url" />
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Titre</label>
        <input id="galerie-form-titre" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Titre du média" />
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Texte alternatif</label>
        <input id="galerie-form-alt" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Description pour l'accessibilité" />
      </div>
      <div style="display:flex; gap:14px; flex-wrap:wrap;">
        <div style="flex:1; min-width:180px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Crédit</label>
          <input id="galerie-form-credit" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="ex. ANB Bordeaux" />
        </div>
        <div style="flex:1; min-width:180px;">
          <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Type</label>
          <select id="galerie-form-type" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px; background:transparent;">
            <option>Photo</option>
            <option>Vidéo</option>
          </select>
        </div>
      </div>
      <div style="display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; border-top:1px solid rgba(31,41,37,0.07); padding-top:20px;">
        <button type="button" class="nav-trigger-btn" data-page="galerie" style="background:#FFFFFF; color:#1F2925; border:2px solid rgba(31,41,37,0.15); padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Annuler</button>
        <button id="publish-galerie-submit-btn" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 26px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Ajouter à la galerie</button>
      </div>
      <div id="galerie-publish-success-alert" class="hidden" style="background:rgba(23,107,77,0.08); color:#176B4D; padding:14px 18px; border-radius:12px; font-size:13.5px; font-weight:700;">✓ Média enregistré avec succès.</div>
    </div>
  </div>
</section>
