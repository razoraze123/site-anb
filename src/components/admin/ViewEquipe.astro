---
// Vue « Équipe » (liste) et « Ajouter/Modifier un membre » (formulaire).
// Markup partagé entre /admin et /superadmin — la logique vit dans
// src/lib/adminContent.js, même principe que Galerie (P1.3). equipe est
// la source de vérité du bloc Bureau/Équipe de /association (remplace
// demo-data.ts teamMembers).
---

<section id="view-equipe" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px;">
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Équipe</h1>
      <button class="btn-create-equipe nav-trigger-btn" data-page="equipe-new" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Ajouter un membre</button>
    </div>
    <div id="equipe-list-container" style="display:flex; flex-direction:column; gap:12px;">
      <!-- liste générée dynamiquement -->
    </div>
  </div>
</section>

<section id="view-equipe-new" class="hidden fade-in">
  <div style="display:flex; flex-direction:column; gap:20px; max-width:640px;">
    <div style="display:flex; align-items:center; gap:14px;">
      <button class="nav-trigger-btn" data-page="equipe" style="width:36px; height:36px; border-radius:10px; background:#FFFFFF; border:1px solid rgba(31,41,37,0.1); cursor:pointer; display: flex; align-items: center; justify-content: center;">←</button>
      <h1 style="font-size:22px; font-weight:800; color:#1F2925; margin:0;">Ajouter un membre</h1>
    </div>
    <div style="background:#FFFFFF; border-radius:20px; padding:28px; box-shadow:0 8px 24px rgba(31,41,37,0.05); display:flex; flex-direction:column; gap:18px;">
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:8px;">Photo (facultative)</label>
        <div id="equipe-upload-zone" style="border:2px dashed #d8cfb8; border-radius:14px; padding:40px 30px; text-align:center; color:#9aa39c; font-size:13.5px; cursor:pointer; background:#FFFFFF; position:relative; overflow:hidden; transition:all 0.15s ease; display:flex; align-items:center; justify-content:center; min-height:140px;">
          <span id="equipe-upload-placeholder" style="z-index:10;">Glissez-déposez une image ici, ou cliquez pour parcourir</span>
        </div>
        <input type="file" id="equipe-image-input" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none;" />
        <input type="hidden" id="equipe-form-image-url" />
        <div style="font-size:11.5px; color:#9aa39c; margin-top:6px;">Formats acceptés : JPEG, PNG, WebP ou GIF. Sans photo, un visuel de repli sera affiché.</div>
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Nom</label>
        <input id="equipe-form-nom" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="Nom complet" />
      </div>
      <div>
        <label style="font-size:13px; font-weight:700; color:#1F2925; display:block; margin-bottom:6px;">Fonction</label>
        <input id="equipe-form-fonction" style="width:100%; padding:12px 14px; border-radius:10px; border:1.5px solid #e3dccb; font-size:14.5px;" placeholder="ex. Président, Trésorier…" />
        <div style="font-size:11.5px; color:#9aa39c; margin-top:6px;">Le membre placé en première position (rang 1, tout en haut de la liste — déplaçable avec ↑ / ↓) est celui mis en avant comme Président dans « Mot du Président » sur /association.</div>
      </div>
      <div style="display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; border-top:1px solid rgba(31,41,37,0.07); padding-top:20px;">
        <button type="button" class="nav-trigger-btn" data-page="equipe" style="background:#FFFFFF; color:#1F2925; border:2px solid rgba(31,41,37,0.15); padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Annuler</button>
        <button id="publish-equipe-submit-btn" style="background:#E97824; color:#FFFFFF; border:none; padding:12px 26px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer;">Ajouter à l'équipe</button>
      </div>
      <div id="equipe-publish-success-alert" class="hidden" style="background:rgba(23,107,77,0.08); color:#176B4D; padding:14px 18px; border-radius:12px; font-size:13.5px; font-weight:700;">✓ Membre enregistré avec succès.</div>
    </div>
  </div>
</section>
