---
// Carrousel léger réutilisable pour les visuels de la home alimentés par la
// galerie (media_galerie) — aucune liste de fichiers en dur, jamais de
// librairie externe. Le tirage aléatoire est fait côté appelant (SSR) ;
// ce composant se contente d'afficher ce qu'on lui donne :
// - 0 image  -> repli via le slot "fallback" (identique à l'existant) ;
// - 1 image  -> <img> statique, pas de script ;
// - 2+ images -> fondu automatique entre les images toutes les `intervalMs`.
export interface Props {
  images: { url: string; alt: string }[];
  containerStyle: string;
  intervalMs?: number;
}

const { images, containerStyle, intervalMs = 4500 } = Astro.props;
const isCarousel = images.length > 1;
---

<div style={containerStyle} data-carousel={isCarousel ? '' : undefined} data-interval={intervalMs}>
  {images.length > 0 ? (
    images.map((img, i) => (
      <img
        class={`gc-slide${i === 0 ? ' is-active' : ''}`}
        src={img.url}
        alt={img.alt}
        loading={i === 0 ? 'eager' : 'lazy'}
      />
    ))
  ) : (
    <slot name="fallback" />
  )}
</div>

<style>
  .gc-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .gc-slide.is-active {
    opacity: 1;
  }

  /* Image unique : pas de carrousel, donc pas de fondu à prévoir. */
  div:not([data-carousel]) > .gc-slide {
    transition: none;
  }
</style>

<script>
  function initGalleryCarousels() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-carousel]').forEach((el) => {
      if ((el as HTMLElement).dataset.gcInit) return;
      (el as HTMLElement).dataset.gcInit = 'true';

      const slides = el.querySelectorAll<HTMLElement>('.gc-slide');
      if (slides.length < 2 || reduceMotion) return;

      const intervalMs = parseInt(el.getAttribute('data-interval') || '4500', 10);
      let current = 0;
      setInterval(() => {
        const next = (current + 1) % slides.length;
        slides[current].classList.remove('is-active');
        slides[next].classList.add('is-active');
        current = next;
      }, intervalMs);
    });
  }

  initGalleryCarousels();
</script>
